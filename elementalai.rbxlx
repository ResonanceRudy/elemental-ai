			<Item class="Script" referent="RBXF3140BF5C55B422C880FADFB0A27B9CE">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Loader = game.ReplicatedStorage:WaitForChild("Loader")
local ServerSide = game.ServerStorage:FindFirstChild("ServerSide") or Loader:FindFirstChild("ServerSide")
ServerSide.Parent = game.ServerStorage
local Modules = ServerSide.Modules:GetDescendants()
local SharedModules = Loader.Shared.Modules:GetDescendants()

local tableMod = require(Loader.Shared.Modules.Tables)

_G.Loader = Loader

local allMods:{Instance} = tableMod.Merge({Modules, SharedModules})
for i, module:Instance in allMods do
	
	if not module:HasTag("Initialize") and not module:HasTag("ServerInitialize") then continue end
	task.spawn(function()
		require(module)()
	end)
	if #module:GetChildren() > 25 then
		task.wait()
	end
end]]></ProtectedString>
