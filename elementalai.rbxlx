			<Item class="Script" referent="RBX67F63B3AC80042A8A13B1CECD0488E9B">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Loader = game.ReplicatedStorage:WaitForChild("Loader")
local combatMod = require(Loader.Shared.Modules.SharedCombat)
local serverCombatMod = require(game.ServerStorage:WaitForChild("ServerSide").Modules.ServerCombat)
local statsMod = require(game.ServerStorage:WaitForChild("ServerSide").Modules.CharacterStats)
local teamMod = require(Loader.Shared.Modules.Teams)
local char
local hrp 

script.Parent.Equipped:Connect(function()
	char = script.Parent.Parent
	hrp = char:WaitForChild("HumanoidRootPart")
end)

script.Parent.Activated:Connect(function()
	local hitboxConfig = {
		Attacker = char,
		Team = char:GetAttribute("Team"),

		HitSelf = false,
		HitAllies = false,
		HitEnemies = true,
		HitProjectiles = true,

		QueryType = "GetPartBoundsInBox",


		GetPartBoundsInBoxConfig = {
			CFrame = CFrame.lookAlong(hrp.Position + hrp.CFrame.LookVector * 10, hrp.CFrame.LookVector),
			Size = Vector3.new(20, 5, 20),
			FilterType = Enum.RaycastFilterType.Exclude,
			FilterDescendantsInstances = {},
			CollsionGroup = "Hitbox"
		},
	}

	local result = combatMod.AreaDamage(hitboxConfig)
	local hitAlready = {}
	
	for i, v in result do
		for i, v in result do
			local enemy = v.Parent

			if enemy and not table.find(hitAlready, result.Instance) and not table.find(hitAlready, enemy) then
				if enemy:HasTag("Character") or (enemy:HasTag("Projectile") and enemy.Owner.Value ~= char) then
					if enemy:HasTag("Projectile") and enemy:FindFirstChild("ProjectileRedirect") then
						table.insert(hitAlready, enemy)
						enemy = enemy.ProjectileRedirect.Value
					end

					local damage = statsMod.ApplyMultipliers({Char = char, OtherChar = enemy, StatName = "Damage", Value = 20})
					local knockback = statsMod.ApplyMultipliers({Char = char, OtherChar = enemy, StatName = "Knockback", Value = 200})
					local damageDealt = (enemy:GetAttribute("Health") < damage and enemy:GetAttribute("Health")) or damage

					local knockbackDirection = (enemy.PrimaryPart.Position - hrp.Position).Unit
					serverCombatMod.DealDamage({
						["Target"] = enemy,
						["Damage"] = damage,
					})
					serverCombatMod.DealKnockback({
						["Target"] = enemy,
						["Knockback"] = knockback * knockbackDirection

					})
					
					
					if enemy:HasTag("Projectile") then
						print(enemy:GetAttribute("Health"))
						enemy:SetAttribute("CurrentCFrame", enemy.PrimaryPart.CFrame)
						enemy:SetAttribute("CurrentVelocity", enemy.PrimaryPart.AssemblyLinearVelocity)
						enemy.Owner.Value = char
					end

					table.insert(hitAlready, enemy)
				end
			end
		end
	end
end)]]></ProtectedString>
