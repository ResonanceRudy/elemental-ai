				<Item class="Folder" referent="RBX5D468025EFF44C04AB4722197DC7A512">
					<Properties>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Modules</string>
						<int64 name="SourceAssetId">-1</int64>
						<BinaryString name="Tags"></BinaryString>
						<UniqueId name="UniqueId">6d436cc27613dc5b099c0558000038fc</UniqueId>
					</Properties>
					<Item class="ModuleScript" referent="RBXA3A094CC6A7643E4A6F44F77B6D7F53C">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[
local Loader = game.ReplicatedStorage:WaitForChild("Loader")
local ProjectileMod = require(Loader.Shared.Modules.Projectiles)
local combatMod = require(Loader.Shared.Modules.SharedCombat)
local teamMod = require(Loader.Shared.Modules.Teams)

local CS = game:GetService("CollectionService")
local RS = game:GetService("RunService")

-- Centralized projectile management
local activeProjectiles = {}
local visualProjectiles = {}
local renderSteppedConnection = nil

local activeStep = 0
local visualStep = 0

-- Initialize the single RenderStepped connection
local function initializeRenderStepped()
	if renderSteppedConnection then return end
	
	renderSteppedConnection = RS.RenderStepped:Connect(function(delta)
		
		activeStep += delta
		if activeStep >= 0.02 then
			activeStep = 0
		-- Update active projectiles
			local shift = 0
			for i, projectileData in table.clone(activeProjectiles) do
				local projectile = projectileData.Projectile
				local hitbox = projectileData.Hitbox
				
				-- Handle slithering
				if not projectileData.Slithering and hitbox then
					task.spawn(function()
						local intensity = projectile:GetAttribute("SlitherIntensity")
						local duration = projectile:GetAttribute("SlitherDuration")
						local cooldown = projectile:GetAttribute("SlitherCooldown")

						projectileData.Slithering = true
						local currentVel = hitbox.AssemblyLinearVelocity
						local velRightVector = CFrame.new(Vector3.zero, currentVel).RightVector
						local velUpVector = CFrame.new(Vector3.zero, currentVel).UpVector

						local diff = ((velRightVector * math.random(-intensity*100, intensity*100)/1000) + (velUpVector * math.random(-intensity*100, intensity*100)/1000))
						local targetVel = currentVel + diff

						local time1 = time()
						repeat
							task.wait(.02)
							if not hitbox then break end
							hitbox.AssemblyLinearVelocity += diff * (1 / duration * 25)
							hitbox.AssemblyLinearVelocity -= projectileData.LastSlitherOffset * (2 / duration * 25)
							hitbox.AssemblyLinearVelocity += projectileData.LastSlitherOffset2 * (1 / duration * 25)
						until time() >= time1 + duration/3
						projectileData.LastSlitherOffset2 = projectileData.LastSlitherOffset
						projectileData.LastSlitherOffset = diff

						task.wait(cooldown * math.random(50, 150)/100)
						projectileData.Slithering = false
					end)
				end

				-- Update projectile
				local updateReturn = ProjectileMod.UpdateProjectile({
					Projectile = projectile,
					LastProjectilePosition = projectileData.LastPosition,
					HitAlready = projectileData.HitAlready,
					DeltaTime = delta,
					TimeAtHomingTargetChange = projectileData.TimeAtHomingTargetChanged,
					HomingTarget = projectileData.HomingTarget
				})

				projectileData.HitAlready = updateReturn.HitAlready
				projectileData.LastPosition = updateReturn.LastPosition
				projectileData.HomingTarget = updateReturn.HomingTarget
				projectileData.TimeAtHomingTargetChanged = updateReturn.TimeAtHomingTargetChanged
				
				-- Check if projectile should be removed
				if not (projectile and projectile:GetAttribute("Health") > 0 and projectile:FindFirstChild("Owner") and game.Players:GetPlayerFromCharacter(projectile.Owner.Value) == game.Players.LocalPlayer) then
					table.remove(activeProjectiles, i - shift)
					shift += 1

					if projectile then
						if hitbox then
							hitbox:Destroy()
						end
						task.delay(3, function()
							projectile:Destroy()
						end)
					end
					continue
				end
			end
		end
		
		visualStep += delta
		if visualStep >= 0.05 then
			visualStep = 0
			-- Update visual projectiles
			local shift = 0
			for i, projectileData in table.clone(visualProjectiles) do
				local projectile = projectileData.Projectile
				local clone = projectileData.Clone
				local cloneHitbox = projectileData.CloneHitbox
				
				-- Update clone position and velocity
				cloneHitbox.CFrame = projectile:GetAttribute("CurrentCFrame") or cloneHitbox.CFrame
				cloneHitbox.AssemblyLinearVelocity = projectile:GetAttribute("CurrentVelocity") or cloneHitbox.AssemblyLinearVelocity

				-- Update projectile logic for non-local players
				if game.Players:GetPlayerFromCharacter(projectile.Owner.Value) == nil then
					local updateReturn = ProjectileMod.UpdateProjectile({
						Projectile = clone,
						LastProjectilePosition = projectileData.LastPosition,
						HitAlready = projectileData.HitAlready,
						DeltaTime = delta,
						TimeAtHomingTargetChanged = projectileData.TimeAtHomingTargetChanged,
						HomingTarget = projectileData.HomingTarget
					})

					projectileData.HitAlready = updateReturn.HitAlready
					projectileData.LastPosition = updateReturn.LastPosition
					projectileData.HomingTarget = updateReturn.HomingTarget
					projectileData.TimeAtHomingTargetChanged = updateReturn.TimeAtHomingTargetChanged
				end
				
				-- Check if projectile should be removed
				if not (projectile and projectile:GetAttribute("Health") > 0 and clone and clone:GetAttribute("Health") > 0 and game.Players:GetPlayerFromCharacter(projectile.Owner.Value) ~= game.Players.LocalPlayer) then
					table.remove(visualProjectiles, i - shift)
					shift += 1
					
					-- Clean up clone
					if projectile and projectile:GetAttribute("Health") > 0 and game.Players:GetPlayerFromCharacter(projectile.Owner.Value) == game.Players.LocalPlayer then
						for i, v in projectile:GetChildren() do
							if v:IsA("BasePart") then
								v.Transparency = 0
							elseif v:IsA("Trail") then
								v.Enabled = true
							end
						end
					end
					
					cloneHitbox:Destroy()
					task.delay(3, function()
						clone:Destroy()
					end)
				end
			end
		end
	end)
end

module = function()
	-- Initialize the centralized RenderStepped connection
	initializeRenderStepped()
	
	Loader.Shared.Modules.Projectiles.ClientHitboxEvent.OnClientEvent:Connect(function(config)
		local projectile = config.ProjectileParent:WaitForChild(config.ProjectileName)
		local hitbox = projectile:WaitForChild("Hitbox")
		
		if projectile:GetAttribute("CurrentCFrame") then
			hitbox.CFrame = projectile:GetAttribute("CurrentCFrame")
		end
		if projectile:GetAttribute("CurrentVelocity") then
			hitbox.AssemblyLinearVelocity = projectile:GetAttribute("CurrentVelocity")
		end
		
		-- Generate unique ID for this projectile
		
		-- Store projectile data in centralized table
		table.insert(activeProjectiles, {
			Projectile = projectile,
			Hitbox = hitbox,
			LastPosition = hitbox.Position,
			HitAlready = {},
			Slithering = false,
			LastSlitherOffset = Vector3.new(0,0,0),
			LastSlitherOffset2 = Vector3.new(0,0,0)
		})
	end)
	
	Loader.Shared.Modules.Projectiles.ClientSideProjectileEvent.OnClientEvent:Connect(function(config)
		local projectile = config.ProjectileParent:WaitForChild(config.ProjectileName)
		local hitbox = projectile:WaitForChild("Hitbox")
		
		if game.Players.LocalPlayer.Character == projectile.Owner.Value then return end
		
		local clone = projectile:Clone()
		local cloneHitbox = clone:WaitForChild("Hitbox")
		
		--cloneHitbox.Anchored = true
		clone.Name = clone.Name.."_Visual"
		clone.Parent = workspace:WaitForChild("Projectiles")
		
		local projectileRedirect = Instance.new("ObjectValue")
		projectileRedirect.Name = "ProjectileRedirect"
		projectileRedirect.Value = projectile
		projectileRedirect.Parent = clone
		
		for i, v in projectile:GetChildren() do
			if v:IsA("BasePart") then
				v.Transparency = 1
			elseif v:IsA("Trail") then
				v.Enabled = false
			end
		end
		
		local hitAlready = {}
		local lastPosition = cloneHitbox.Position
		local connection 
		
		-- Generate unique ID for this visual projectile

		-- Store visual projectile data in centralized table
		table.insert(visualProjectiles, {
			Projectile = projectile,
			Clone = clone,
			CloneHitbox = cloneHitbox,
			LastPosition = cloneHitbox.Position,
			HitAlready = {}
		})
	end)
end

return module
]]></ProtectedString>
