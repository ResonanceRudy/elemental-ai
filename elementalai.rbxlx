	<Item class="ServerScriptService" referent="RBX6234B802ECE04D25AD87B723D990256A">
		<Properties>
			<bool name="LoadStringEnabled">false</bool>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
			<string name="Name">ServerScriptService</string>
			<int64 name="SourceAssetId">-1</int64>
			<BinaryString name="Tags"></BinaryString>
			<UniqueId name="UniqueId">7c66d3c8bac7f3c30998088500000b7e</UniqueId>
		</Properties>
		<Item class="Script" referent="RBX144EFE9E27014A449A02D664BD8E9676">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Loader = game.ReplicatedStorage:WaitForChild("Loader")

local Replacements = game.ReplicatedStorage:FindFirstChild("LoaderReplacements")
if Replacements then
	for _, v in {Replacements:FindFirstChild("ServerSide"), Replacements:FindFirstChild("Shared")} do
		if v then
			for _1, folder in v:GetChildren() do
				for i, object in folder:GetChildren() do
					
					local originalObject = Loader[v.Name][folder.Name]:FindFirstChild(object.Name)
					if originalObject then
						originalObject:Destroy()
					end
					object.Parent = Loader[v.Name][folder.Name]
				end
			end
		end
	end
end

local ServerSide = game.ServerStorage:FindFirstChild("ServerSide") or Loader:FindFirstChild("ServerSide")
ServerSide.Parent = game.ServerStorage
local Modules = ServerSide.Modules:GetDescendants()
local SharedModules = Loader.Shared.Modules:GetDescendants()

local tableMod = require(Loader.Shared.Modules.Tables)

local allMods:{Instance} = tableMod.Merge({Modules, SharedModules})
for i, module:Instance in allMods do
	
	if not module:HasTag("Initialize") and not module:HasTag("ServerInitialize") then continue end
	task.spawn(function()
		require(module)()
	end)
	if #module:GetChildren() > 25 then
		task.wait()
	end
end]]></ProtectedString>
