							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Queries</string>
							<int64 name="SourceAssetId">-1</int64>
							<BinaryString name="Tags"></BinaryString>
							<UniqueId name="UniqueId">6d436cc27613dc5b099c055800003905</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXD08B779FEBAC415993EE3DB5461A642D">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local module = {}
local Loader = script.Parent.Parent.Parent

local queryMod = require(script.Parent.Queries)
local teamMod = require(script.Parent.Teams)
local tableMod = require(script.Parent.Tables)

local CS = game:GetService("CollectionService")

type AreaDamageConfig = {
	Attacker:Object,
	Team:string,

	HitSelf:boolean,
	HitEnemies:boolean,
	HitAllies:boolean,
	HitProjectiles:boolean,
	HitCharacters:boolean,

	QueryType:string,

	GetPartsInPartConfig:queryMod.GetPartsInPartConfig,
	GetPartBoundsInBoxConfig:queryMod.GetPartBoundsInBoxConfig,
	GetPartBoundsInRadiusConfig:queryMod.GetPartBoundsInRadiusConfig,
	RaycastConfig:queryMod.RaycastConfig,
}
function module.AreaDamage(config:AreaDamageConfig)
	local allChars = CS:GetTagged("Character")
	local allProjectiles = CS:GetTagged("Projectile")
	
	
	local targetTable = tableMod.Merge({allChars, allProjectiles})
	
	local queryType = config.QueryType
	local queryConfig = config[queryType.."Config"]
	local filterType = (queryConfig.FilterType and queryConfig.FilterType.Name) or "Exclude"
	
	local shift = 0
	for i, v in targetTable do
		local registerConfig = config
		registerConfig.Target = v
		if not teamMod.RegisterHit(registerConfig) then
			if filterType == "Exclude" then
				table.insert(queryConfig.FilterDescendantsInstances, v)
			else
				table.remove(queryType.FilterDescendantsInstances, table.find(queryConfig.FilterDescendantsInstances, v))
			end
		end
	end
	
	local results = queryMod[queryType](queryConfig)
	return results
end
return module
]]></ProtectedString>
							<string name="ScriptGuid">{C5954711-EB09-4CBB-9D0D-A2933550A527}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">SharedCombat</string>
							<int64 name="SourceAssetId">-1</int64>
							<BinaryString name="Tags"></BinaryString>
							<UniqueId name="UniqueId">6d436cc27613dc5b099c055800003906</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX86AD6593EC1D484B8A3284287DBDB92D">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local module = {}

type PlaySoundConfig = {
	SoundObject: Sound,
	Part: Part,
	Position: Vector3,
	DeleteOnEnd: boolean
}
function module.PlaySound(config)
	local sound = config.SoundObject
	local part = config.Part or script.Parent.Parent.Assets.SoundPart:Clone()
	
	if config.Position then
		part.Position = config.Position
	end
	
	if part.Name == "SoundPart" then
		local soundPartFolder = workspace:FindFirstChild("SoundParts") or Instance.new("Folder", workspace)
		if soundPartFolder.Name ~= "SoundParts" then
			soundPartFolder.Name = "SoundParts"
		end
		
		part.Parent = soundPartFolder
	end
	
	sound:Play()
	
	if config.DeleteOnEnd then
		sound.Ended:Connect(function()
			if sound then 
				sound:Destroy()
			end
			if part.Name == "SoundPart" then
				part:Destroy()
			end
		end)
	end
	
	return sound
end

return module
]]></ProtectedString>
