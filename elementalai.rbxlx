				</Item>
				<Item class="Script" referent="RBX8862EC5B69ED41089F5E1E02C49C1B56">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local serverCombatMod = require(game.ServerStorage:WaitForChild("ServerSide").Modules.ServerCombat)
local char = (script.Parent.Name == "Debuffs" and script.Parent.Parent) or script.Parent

local effects = {}

function AddEffect(part)
	local frozenEffect = script.FrozenEffect:Clone()
	frozenEffect.Parent = part
	frozenEffect.Enabled = true
	local snowflakeEffect = script.SnowflakeEffect:Clone()
	snowflakeEffect.Parent = part
	snowflakeEffect.Enabled = true
	table.insert(effects, frozenEffect)
	table.insert(effects, snowflakeEffect)
end

if char:IsA("BasePart") and not char:GetAttribute("Destroyed") then
	AddEffect(char)
else
	for i, v in char:GetChildren() do
		if v:IsA("BasePart") then
			AddEffect(v)
		end
	end
end

local timeStarted = time()
local slowAmount = script:GetAttribute("SlowStrength")

if char:GetAttribute("WalkSpeed") then
	char:SetAttribute("WalkSpeed", char:GetAttribute("WalkSpeed") - slowAmount)
end

if char:IsA("BasePart") then
	local colorR = char.Color.R
	local colorG = char.Color.G
	local colorB = char.Color.B
	
	local targetColor = Color3.new(0.7, 1, 1)
	local newColor = Color3.new((colorR*9 + targetColor.R)/10, (colorG*9 + targetColor.G)/10,(colorB*9 + targetColor.B)/10)
	char.Color = newColor
end

while time() - timeStarted < script:GetAttribute("Duration") do
	if char:GetAttribute("WalkSpeed") and script:GetAttribute("SlowStrength") ~= slowAmount then
		local diff = script:GetAttribute("SlowStrength") - slowAmount
		slowAmount = script:GetAttribute("SlowStrength")
		char:SetAttribute("WalkSpeed", char:GetAttribute("WalkSpeed") - diff)
	end
	task.wait(.25)
end

if char:GetAttribute("WalkSpeed") then
	char:SetAttribute("WalkSpeed", char:GetAttribute("WalkSpeed") + slowAmount)
end

for i, v in effects do
	v.Enabled = false
	task.delay(v.Lifetime.Max, function()
		v:Destroy()
	end)
	
end
task.wait(1)
script:Destroy()]]></ProtectedString>
