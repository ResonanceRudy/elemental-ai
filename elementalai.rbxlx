					</Item>
					<Item class="ModuleScript" referent="RBX6589B53ADAD64BBF8F1BC7DBE71C62A8">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local plr = Players.LocalPlayer

local Loader = game.ReplicatedStorage.Loader
local Modules = Loader.Shared.Modules
local VectorMod = require(Modules.Vectors)
local RS = game:GetService("RunService")


local CharacterAdded = function(char:Model)
	
	
	local connection:RBXScriptConnection
	local appearanceLoaded = plr:HasAppearanceLoaded() or plr.CharacterAppearanceLoaded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart")
	--cam.CameraSubject = hrp

	char:AddTag("Character")
	char.PrimaryPart = char.HumanoidRootPart

	-- Chaeacter controller stuff
	char.Humanoid.EvaluateStateMachine = false 
	task.wait()
	local ControllerManager:ControllerManager = char:WaitForChild("ControllerManager")
	local GroundController:GroundController = ControllerManager:WaitForChild("GroundController")
	local AirController:AirController = ControllerManager:WaitForChild("AirController")
	local GroundSensor:ControllerPartSensor = ControllerManager:WaitForChild("GroundSensor")
	local IsSliding = false
	local humanoid = char.Humanoid
	

	local function Movement()
		local direction = humanoid.MoveDirection

		ControllerManager.MovingDirection = direction

		if direction.Magnitude > 0 then
			-- MoveDirection is world-space horizontal (no Y component).
			-- On a wall, the GroundController remaps movement onto the surface,
			-- but FacingDirection still needs the surface-relative direction.
			--
			-- Rotate the MoveDirection by the same rotation that takes world-up
			-- to the current UpDirection. On the floor this is identity (no change).
			-- On a wall this rotates the horizontal input onto the wall plane.
			local up = ControllerManager.UpDirection.Unit
			local worldUp = Vector3.yAxis

			local surfaceDirection
			if math.abs(up:Dot(worldUp)) > 0.999 then
				-- On the floor/ceiling, no remapping needed
				surfaceDirection = direction
			else
				-- Build rotation from world-up to surface UpDirection
				local axis = worldUp:Cross(up).Unit
				local angle = math.acos(math.clamp(worldUp:Dot(up), -1, 1))
				local rotation = CFrame.fromAxisAngle(axis, angle)
				surfaceDirection = rotation * direction
			end

			if surfaceDirection.Magnitude > 0.001 then
				ControllerManager.FacingDirection = surfaceDirection.Unit
			else
				ControllerManager.FacingDirection = hrp.CFrame.LookVector
			end
		else
			ControllerManager.FacingDirection = hrp.CFrame.LookVector
		end
	end

	local function updateControllerManagerSensor()
		local raycastParams = RaycastParams.new()
		raycastParams.FilterDescendantsInstances = {char} -- Character should not be included within things that the raycast can return
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		raycastParams.RespectCanCollide = true
	
		local raycastToGround = workspace:Raycast(hrp.Position, GroundSensor.SearchDistance * -ControllerManager.UpDirection, raycastParams)
		
		GroundController.AccelerationTime = char:GetAttribute("AccelerationTime") or 0
		GroundController.DecelerationTime = char:GetAttribute("DecelerationTime") or 0
		
		if raycastToGround then -- Character is on the ground, raycast returned something
			GroundSensor.SensedPart = raycastToGround.Instance
			GroundSensor.HitNormal = raycastToGround.Normal
			GroundSensor.HitFrame = CFrame.new(raycastToGround.Position)
			
			
			if VectorMod.GetAngle(raycastToGround.Normal, Vector3.yAxis) > (char:GetAttribute("MaxSlopeAngle") or 90)+.1 then
				GroundController.Friction = 0
				IsSliding = true
			else
				GroundController.Friction = char:GetAttribute("Friction") or 0
				IsSliding = false
			end
			
			if IsSliding == false and (char:GetAttribute("StandPerpendicularToFloor") or false) then
				ControllerManager.UpDirection = (GroundSensor.HitNormal + ControllerManager.UpDirection*7)/8
			end
			
			if not IsSliding and char:GetAttribute("GravityDirection") ~= -GroundSensor.HitNormal and (char:GetAttribute("GravityPerpendicularToFloor") or false) then
				script.ChangeGravityDirectionEvent:FireServer(-GroundSensor.HitNormal)
			end
			if not (VectorMod.GetAngle(raycastToGround.Normal, Vector3.yAxis) <= (char:GetAttribute("MaxSlopeAngle") or 90)) then
				GroundController.Friction = 0
				IsSliding = true
			else
				GroundController.Friction = char:GetAttribute("Friction") or 0
				IsSliding = false
			end
			
			humanoid:ChangeState(Enum.HumanoidStateType.Running) -- Changing humanoid states so we have animations 
			ControllerManager.ActiveController = GroundController -- Switch the ActiveController to GroundController. 
		else -- Character is midair, raycast didn't return anything
			humanoid:ChangeState(Enum.HumanoidStateType.Freefall) 
			local gravDir = char:GetAttribute("GravityDirection") or -Vector3.yAxis
			ControllerManager.UpDirection = (-gravDir + ControllerManager.UpDirection*7)/8
			ControllerManager.ActiveController = nil
			ControllerManager.ActiveController = AirController
			
			AirController.MoveMaxForce = char:GetAttribute("AirInfluence")*1500 or 1500
			
			--print(AirController.MoveSpeedFactor)
			--AirController.MoveMaxForce = hrp.AssemblyLinearVelocity.Magnitude * ControllerManager.BaseMoveSpeed * airInfluence
		end
		
		

		--print(char:GetAttribute("GravityDirection"))
	end


	local function doJump()
		if humanoid:GetState() ~= Enum.HumanoidStateType.Ragdoll and not IsSliding then
			--local jumpImpulse = Vector3.new(0, 750, 0) -- jump power

			ControllerManager.RootPart:ApplyImpulse(humanoid.JumpPower*15 * ControllerManager.UpDirection)

			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			ControllerManager.ActiveController = AirController

			local floor = ControllerManager.GroundSensor.SensedPart
			if floor then
				floor:ApplyImpulseAtPosition(Vector3.new(0, -humanoid.JumpPower, 0), ControllerManager.GroundSensor.HitNormal)
			end
		end
	end

	local jumpTime = time()
	local function updateCharacter()
		updateControllerManagerSensor()
		Movement()

		local jumpCD = char:GetAttribute("JumpCooldown") or 0.1
		if humanoid.Jump and ControllerManager.ActiveController == GroundController and time() - jumpTime > jumpCD then
			jumpTime = time()
			doJump()
		end
	end
	
	connection = RS.RenderStepped:Connect(function(dt)
		updateCharacter()
	end)
	
	-- Cleanup
	char.Destroying:Connect(function()
		connection:Disconnect()
	end)
end

return function()
	plr.CharacterAdded:Connect(CharacterAdded)
	if plr.Character then
		CharacterAdded(plr.Character)
	end
end]]></ProtectedString>
