						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local Loader = game.ReplicatedStorage.Loader
local PartsModInstance = Loader.Shared.Modules.Parts
local PartsMod = require(PartsModInstance)

local Debris = game:GetService("Debris")

module = function()
	PartsModInstance.PartDestructionEvent.OnClientEvent:Connect(function(partToClone)
		if partToClone and (not workspace:FindFirstChild("Debris") or #workspace.Debris:GetChildren() < 500) then
			local part:BasePart = partToClone:Clone()
			part.AssemblyLinearVelocity = partToClone:GetAttribute("DebrisVelocity")
			part.AssemblyAngularVelocity += Vector3.new(math.random(-25, 25), math.random(-25, 25), math.random(-25, 25))
			part.CollisionGroup = "Debris"
			
			local debrisFolder = workspace:FindFirstChild("Debris") or Instance.new("Folder")
			debrisFolder.Name = "Debris"
			debrisFolder.Parent = workspace
			part.Parent = debrisFolder
			Debris:AddItem(part, 11)
			
			part.CanQuery = false
			part.CanTouch = false
			part.CanCollide = true
			part.Anchored = false
			part.Transparency -= 1
			
			
			local isOnFire = false
			for i, emitter in part:GetChildren() do
				if emitter:IsA("ParticleEmitter") then
					emitter.Enabled = true
					if emitter.Name == "FireDamageEffectMap" then
						isOnFire = true
					end
				end
			end
			
			local effectCloneConnection = partToClone.ChildAdded:Connect(function(child)
				if child:IsA("ParticleEmitter") then
					local effect = child:Clone()
					effect.Parent = part
					effect.Enabled = true
					
					if effect.Name == "FireDamageEffectMap" then
						isOnFire = true
					end
				end
			end)
			
			local timeStarted = time()
			local waitTime = math.random(50, 100)/10
			repeat
				if isOnFire then
					part.Color = Color3.new(part.Color.R * .99, part.Color.G * .99, part.Color.B * .99)
					task.wait(.1)
				else
					task.wait(.5)
				end
			until time() >= timeStarted + waitTime
			for count = 1, 50, 1  do
	
				part.Transparency += .02
				task.wait()
			end
			
			effectCloneConnection:Disconnect()
			part:Destroy()
		end
	end)
end

return module
]]></ProtectedString>
							<string name="ScriptGuid">{4B512CD7-0F1D-4BA4-BAE5-427DF07F1A9A}</string>
