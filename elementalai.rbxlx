				</Item>
			</Item>
			<Item class="Folder" referent="RBX54EA8976F5EE4A979518A8BB07B0688D">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Shared</string>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
					<UniqueId name="UniqueId">6d436cc27613dc5b099c055800003900</UniqueId>
				</Properties>
				<Item class="Folder" referent="RBXA4397D8C1756451F874B74BEB9AB4A72">
					<Properties>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Modules</string>
						<int64 name="SourceAssetId">-1</int64>
						<BinaryString name="Tags"></BinaryString>
						<UniqueId name="UniqueId">6d436cc27613dc5b099c055800003901</UniqueId>
					</Properties>
					<Item class="ModuleScript" referent="RBX0BF14489000E449F865CFE858B932533">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local module = {}
local Loader = game.ReplicatedStorage:WaitForChild("Loader")
local combatMod = require(Loader.Shared.Modules.SharedCombat)
local serverCombatMod
local statsMod
local RS = game:GetService("RunService")
if RS:IsServer() then
	serverCombatMod = require(game.ServerStorage:WaitForChild("ServerSide").Modules.ServerCombat)
	statsMod = require(game.ServerStorage:WaitForChild("ServerSide").Modules.CharacterStats)
end

local teamMod = require(script.Parent.Teams)



type ExplosionHitDetectionConfig = {
	Position:Vector3,
	Radius:number,
	Owner:Object?,
	
	Damage:number,
	Knockback:number,
	
	Team:string,
	
	HitSelf:boolean?,
	HitAllies:boolean?,
	HitEnemies:boolean?,
	HitProjectiles:boolean?,
	HitCharacters:boolean?,
	HitMap:boolean?,
	
	FilterType:Enum.RaycastFilterType,
	FilterDescendantsInstances:{Instance},
	
	Visualize:boolean,
	
	StartColor:Color3,
	MiddleColor:Color3,
	EndColor:Color3,
	
	StartSize:number,
	MiddleSize:number,
	EndSize:number,
	
	StartTransparency:number,
	MiddleTransparency:number,
	EndTransparency:number,
	
	StartDuration:number,
	EndDuration:number,
	
	StartTweenStyle:Enum.EasingStyle,
	StartTweenDirection:Enum.EasingDirection,
	EndTweenStyle:Enum.EasingStyle,
	EndTweenDirection:Enum.EasingDirection,
}
function module.ExplosionHitDetection(config:ExplosionHitDetectionConfig)
	--[[if RS:IsClient() then
		print("hi")
	end]]
	local hitboxConfig = {
		Attacker = config.Owner,
		Team = config.Team,

		HitSelf = config.HitSelf or false,
		HitAllies = config.HitAllies or false,
		HitEnemies = config.HitEnemies or true,
		HitProjectiles = config.HitProjectiles or true,
		HitCharacters = config.HitCharacters or true,

		QueryType = "GetPartBoundsInRadius",

		
		GetPartBoundsInRadiusConfig = {
			Position = config.Position,
			Radius = config.Radius,
			FilterType = config.FilterType or Enum.RaycastFilterType.Exclude,
			FilterDescendantsInstances = config.FilterDescendantsInstances or {},
			CollisionGroup = "HitboxWithMap"
		}
	}
	local result = combatMod.AreaDamage(hitboxConfig)
	
	module.ExplosionServer({HitDetectionConfig = config, HitDetectionResult = result})
end

type ExplosionServerConfig = {
	HitDetectionConfig:ExplosionHitDetectionConfig,
	HitDetectionResult:{Instance},
	HitDetectOnClient:boolean
}
function module.ExplosionServer(config:ExplosionServerConfig)
	if RS:IsServer() then
		local hitAlready = {}
		local result = config.HitDetectionResult
		
		local firstConfig = config.HitDetectionConfig
		
		if firstConfig.Visualize ~= false then
			local explosion = script.Parent.Parent.Assets.Explosion:Clone()
			explosion.Position = config.HitDetectionConfig.Position
			
			local ProjectileFolder = workspace:FindFirstChild("Projectiles") or Instance.new("Folder")
			ProjectileFolder.Name = "Projectiles"
			ProjectileFolder.Parent = workspace
			
			explosion.Parent = ProjectileFolder
			
			explosion.Color = firstConfig.StartColor or teamMod.Teams[firstConfig.Team] and teamMod.Teams[firstConfig.Team].Color or explosion.Color
			explosion.Transparency = firstConfig.StartTransparency or 0
			explosion.Size = (firstConfig.StartSize and firstConfig.StartSize * Vector3.one) or Vector3.new(0,0,0)
			
			local firstTween = game:GetService("TweenService"):Create(explosion, TweenInfo.new(
					firstConfig.StartDuration or 0.1,
					firstConfig.StartTweenStyle or Enum.EasingStyle.Linear,
					firstConfig.StartTweenDirection or Enum.EasingDirection.Out,
					0,
					false,
					0
				), {
					Size = (firstConfig.MiddleSize or firstConfig.Radius*2) * Vector3.one,
					Transparency = firstConfig.MiddleTransparency or 0.1,
					Color = firstConfig.MiddleColor or explosion.Color,
				})
			firstTween:Play()
			
			task.delay(firstConfig.StartDuration or 0.1, function()
				local secondTween = game:GetService("TweenService"):Create(explosion, TweenInfo.new(
					firstConfig.EndDuration or 0.75,
					firstConfig.EndTweenStyle or Enum.EasingStyle.Exponential,
					firstConfig.EndTweenDirection or Enum.EasingDirection.Out,
					0,
					false,
					0
				), {
					Size = (firstConfig.EndSize or 0) * Vector3.one,
					Transparency = firstConfig.EndTransparency or 1,
					Color = firstConfig.EndColor or explosion.Color,
				})
				secondTween:Play()
				task.wait(firstConfig.EndDuration or 0.5)
				explosion:Destroy()
			end)
		end
		
		
		local function CheckForExclude(enemy)
			return ((enemy and (table.find(hitAlready, enemy) or not enemy:IsDescendantOf(workspace))) or (not teamMod.RegisterHit({Attacker = firstConfig.Owner, Team = firstConfig.Team, Target = enemy, HitAllies = firstConfig.HitAllies, HitEnemies = firstConfig.HitEnemies, HitProjectiles = firstConfig.HitProjectiles, HitCharacters = firstConfig.HitCharacters, HitSelf = firstConfig.HitSelf})) or not enemy:GetAttribute("Health") or enemy:GetAttribute("Health") <= 0 or (enemy:HasTag("Projectile") and (not enemy:FindFirstChild("Owner") or firstConfig.Owner)))
		end
		
		for i, v in result do
			local enemy = v.Parent
			
			local exclude = false
			if CheckForExclude(enemy) or (game.Players:GetPlayerFromCharacter(enemy) and not game.Players:GetPlayerFromCharacter(firstConfig.Owner) and not config.HitDetectOnClient) then
				exclude = true
			end

			if enemy and not exclude and not table.find(hitAlready, v) and not table.find(hitAlready, enemy) then
				if enemy:HasTag("Character") or (enemy:HasTag("Projectile") and enemy.Owner.Value ~= firstConfig.Owner) then
					--print(enemy)
					if enemy:HasTag("Projectile") and enemy:FindFirstChild("ProjectileRedirect") then
						table.insert(hitAlready, enemy)
						enemy = enemy.ProjectileRedirect.Value
					end
					
					local isAlly = teamMod.IsAlly(firstConfig.Team, enemy)
					if ((isAlly and not firstConfig.HitAllies and enemy ~= firstConfig.Owner) or (not isAlly and not firstConfig.HitEnemies) or (enemy == firstConfig.Owner and not firstConfig.HitSelf) or (enemy:HasTag("Projectile") and not firstConfig.HitProjectiles))then
						return
					end

					local damage = statsMod.ApplyMultipliers({Char = firstConfig.Owner, OtherChar = enemy, StatName = "Damage", Value = firstConfig.Damage})
					local knockback = statsMod.ApplyMultipliers({Char = firstConfig.Owner, OtherChar = enemy, StatName = "Knockback", Value = firstConfig.Knockback})
					local damageDealt = (enemy:GetAttribute("Health") < damage and enemy:GetAttribute("Health")) or damage

					local knockbackDirection = ((enemy.PrimaryPart.Position - firstConfig.Position).Unit*2 + Vector3.yAxis).Unit
					serverCombatMod.DealDamage({
						["Attacker"] = firstConfig.Owner,
						["Target"] = enemy,
						["Damage"] = damage,
					})
					serverCombatMod.DealKnockback({
						["Attacker"] = firstConfig.Owner,
						["Target"] = enemy,
						["Knockback"] = knockback * knockbackDirection

					})
					
					table.insert(hitAlready, enemy)
				end
			elseif v.CollisionGroup == "Map" and v:GetAttribute("Health") and not table.find(hitAlready, v) then
				local damage = statsMod.ApplyMultipliers({Char = firstConfig.Owner, OtherChar = nil, StatName = "Damage", Value = firstConfig.Damage})
				local knockbackDirection = ((v.Position - firstConfig.Position).Unit*2 + Vector3.yAxis).Unit
				local knockback = statsMod.ApplyMultipliers({Char = firstConfig.Owner, OtherChar = nil, StatName = "Knockback", Value = firstConfig.Knockback})
				serverCombatMod.DealDamage({
					["Attacker"] = firstConfig.Owner,
					["Target"] = v,
					["Damage"] = damage
				})
				serverCombatMod.DealKnockback({
					["Attacker"] = firstConfig.Owner,
					["Target"] = v,
					["Knockback"] = knockback * knockbackDirection
				})
				table.insert(hitAlready, v)
			end
		end
	else
		config.HitDetectOnClient = true
		script.ExplosionEvent:FireServer(config)
	end
end

return module
]]></ProtectedString>
							<string name="ScriptGuid">{5B7F2A55-56F6-4B28-B0AD-23C5D125B400}</string>
