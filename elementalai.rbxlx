			<Item class="LocalScript" referent="RBX834A36C72B2842B0883877FF28CE57B4">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Loader = game.ReplicatedStorage:WaitForChild("Loader")

local Replacements = game.ReplicatedStorage:FindFirstChild("LoaderReplacements")
if Replacements then
	for _, v in {Replacements:FindFirstChild("ClientSide"), Replacements:FindFirstChild("Shared")} do
		if v then
			for _1, folder in v:GetChildren() do
				for i, object in folder:GetChildren() do
					local originalObject = Loader[v.Name][folder.Name]:FindFirstChild(object.Name)
					if originalObject then
						originalObject:Destroy()
					end
					object.Parent = Loader[v.Name][folder.Name]
				end
			end
		end
	end
end

local Modules = Loader.ClientSide.Modules:GetDescendants()
local SharedModules = Loader.Shared.Modules:GetDescendants()

local tableMod = require(Loader.Shared.Modules.Tables)

local allMods:{Instance} = tableMod.Merge({Modules, SharedModules})
for i, module:Instance in allMods do

	if not module:HasTag("Initialize") and not module:HasTag("ClientInitialize") then continue end
	task.spawn(function()
		require(module)()
	end)
	if #module:GetChildren() > 25 then
		task.wait()
	end
end]]></ProtectedString>
