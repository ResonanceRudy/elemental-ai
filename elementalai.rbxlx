					</Item>
					<Item class="ModuleScript" referent="RBXC246AD1BF87742A5B65BF618AC45B98F">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local modules = game.ServerStorage:WaitForChild("ServerSide").Modules

local StatMod = require(modules.CharacterStats)

local Players = game:GetService("Players")




return function()
	local PlayerAddedFunction = function(plr:Player)
		plr.CharacterAdded:Connect(function(char:Model)
			
			local appearanceLoaded = plr:HasAppearanceLoaded() or plr.CharacterAppearanceLoaded:Wait()

			--[[for i, part in char:GetChildren() do
				if part:IsA("BasePart") then
					
				end
			end]]
			
			char:AddTag("Character")
			char.PrimaryPart = char.HumanoidRootPart
			
			for i, v in pairs(char:GetChildren()) do
				if v:IsA("Accessory") then
					v.Handle.CanQuery = false
				end
			end
			
			
			-- Chaeacter controller stuff
			char.Humanoid.EvaluateStateMachine = false 
			task.wait()
			local hrp = char:WaitForChild("HumanoidRootPart")

			local ControllerManager = Instance.new("ControllerManager")
			ControllerManager.Parent = char
			ControllerManager.RootPart = hrp
			ControllerManager.BaseMoveSpeed = 25
			ControllerManager.BaseTurnSpeed = 20
			ControllerManager.FacingDirection = hrp.CFrame.LookVector

			local groundSensor = Instance.new("ControllerPartSensor")
			groundSensor.Name = "GroundSensor"
			groundSensor.SensorMode = Enum.SensorMode.Floor
			groundSensor.UpdateType = Enum.SensorUpdateType.Manual
			groundSensor.SearchDistance = 3.5
			
			local GroundController = Instance.new("GroundController")
			GroundController.GroundOffset = 2
			GroundController.BalanceRigidityEnabled = true 
			GroundController.AccelerationLean = 10

			local AirController = Instance.new("AirController")
			AirController.MaintainLinearMomentum = true 
			AirController.MaintainAngularMomentum = false 
			AirController.BalanceRigidityEnabled = true 

			-- Parenting the controllers
			GroundController.Parent = ControllerManager
			AirController.Parent = ControllerManager
			groundSensor.Parent = ControllerManager
			ControllerManager.GroundSensor = groundSensor
			
			StatMod.HandleStats(char, true)
		end)
	end
	
	for i, plr in Players:GetPlayers() do
		PlayerAddedFunction(plr)
	end	
	Players.PlayerAdded:Connect(PlayerAddedFunction)
end]]></ProtectedString>
