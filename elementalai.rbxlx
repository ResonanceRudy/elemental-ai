							<int64 name="SourceAssetId">-1</int64>
							<BinaryString name="Tags"></BinaryString>
							<UniqueId name="UniqueId">6d436cc27613dc5b099c055800003902</UniqueId>
						</Properties>
						<Item class="RemoteEvent" referent="RBX35CB17CE2B464BE2A07C8420C11A80BC">
							<Properties>
								<BinaryString name="AttributesSerialize"></BinaryString>
								<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
								<bool name="DefinesCapabilities">false</bool>
								<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
								<string name="Name">ExplosionEvent</string>
								<int64 name="SourceAssetId">-1</int64>
								<BinaryString name="Tags"></BinaryString>
								<UniqueId name="UniqueId">6d436cc27613dc5b099c055800003903</UniqueId>
							</Properties>
						</Item>
					</Item>
					<Item class="ModuleScript" referent="RBX5152CEA840E24A37A1C2177C2E0EAA9A">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local module = {}

local TeamMod = require(script.Parent.Teams)

type FindTargetConfig = {
	Character:Model,
	FOV:number,
	Range:number,
	Position:Vector3,

	HitAllies:boolean,
	HitEnemies:boolean,
	HitSelf:boolean,
	HitProjectiles:boolean,
	HitCharacters:boolean,
	
	FilterType:string,
	FilterDescendantsInstances:{Instance},
	SeeThroughWalls:boolean
}
function module.FindTarget(config:FindTargetConfig)
	local char = config.Character
	local hrp = char.PrimaryPart
	
	return TeamMod.FindTarget({
		Attacker = char,
		Team = char:GetAttribute("Team"),

		LookVector = hrp.CFrame.LookVector,
		Range = config.Range,
		FOV = config.FOV,
		Position = config.Position or hrp.Position,
		
		HitAllies = config.HitAllies,
		HitEnemies = config.HitEnemies,
		HitSelf = config.HitSelf,
		HitProjectiles = config.HitProjectiles,
		HitCharacters = config.HitCharacters,
		
		FilterType = config.FilterType,
		FilterDescendantsInstances = config.FilterDescendantsInstances,
		SeeThroughWalls = config.SeeThroughWalls
	})
end

type LookAtConfig = {
	Character:Model,
	Position:Vector3
}

function module.LookAt(config)
	local alignOri = config.Character:FindFirstChild("AlignOrientation")
	local hrp = config.Character.PrimaryPart
	
	if alignOri and config.Position then
		alignOri.CFrame = CFrame.new(hrp.Position, Vector3.new(config.Position.X, hrp.Position.Y, config.Position.Z))
		alignOri.Enabled = true
	end
end

type PlayAnimationConfig = {
	Character:Model,
	Animation:Animation
}

function module.PlayAnimation(config:PlayAnimationConfig)
	local humanoid = config.Character:FindFirstChild("Humanoid")
	local animator = humanoid:FindFirstChild("Animator")
	local track 
	
	if animator then
		track = animator:LoadAnimation(config.Animation)
		track:Play()
	end
	return track
end

type PathfindConfig = {
	Character:Model,
	Position:Vector3,
	Settings:{[string]:any},
}
function module.Pathfind(config:PathfindConfig)
	local pathSettings = config.Settings or {}
	local char = config.Character
	local humanoid = char:FindFirstChild("Humanoid")
	local hrp = char.PrimaryPart
	local start = hrp.Position
	local finish = config.Position
	
	local nextWaypointIndex
	local blockedConnection
	local reachedConnection
	local defaultSettings = {
		AgentHeight = 5,
		AgentRadius = 2.5,
		AgentCanJump = true,
		AgentCanClimb = true,
		WaypointSpacing = math.huge,
		Costs = {
			Climb = 2,
			Jump = 10
		}
	}
	
	local pathSettings = setmetatable(pathSettings, {__index = defaultSettings})
	local path = game:GetService("PathfindingService"):CreatePath(pathSettings)
	local function PathFunction(pos)
		path:ComputeAsync(start, finish)
		if path.Status == Enum.PathStatus.Success then
			local waypoints = path:GetWaypoints()

			blockedConnection = path.Blocked:Connect(function(blockedIndex)
				if blockedIndex >= nextWaypointIndex then
					blockedConnection:Disconnect()
					blockedConnection = nil
					PathFunction(pos)
				end
			end)

			if not reachedConnection then
				reachedConnection = humanoid.MoveToFinished:Connect(function(reached)
					if reached and nextWaypointIndex < #waypoints then
						-- Increase waypoint index and move to next waypoint
						nextWaypointIndex += 1
						local waypoint:PathWaypoint = waypoints[nextWaypointIndex]
						humanoid:MoveTo(waypoint.Position)
						if waypoint.Action == Enum.PathWaypointAction.Jump and humanoid.FloorMaterial.Name ~= "Air" then
							humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
						end
					else
						reachedConnection:Disconnect()
						reachedConnection = nil
						blockedConnection:Disconnect()
						blockedConnection = nil
					end
				end)
			end
			if waypoints[1].Action == Enum.PathWaypointAction.Jump and humanoid.FloorMaterial.Name ~= "Air" then
				humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			end
			nextWaypointIndex = 2
			local waypoint:PathWaypoint = waypoints[nextWaypointIndex]
			humanoid:MoveTo(waypoint.Position)
			if waypoint.Action == Enum.PathWaypointAction.Jump then
				humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			elseif waypoint.Label == "Climb" then
				humanoid:MoveTo(waypoint.Position)
			end
		end
	end
	PathFunction(finish)
	return reachedConnection

end



return module
]]></ProtectedString>
							<string name="ScriptGuid">{D0CAD1E8-11E0-4F86-8F12-5C0D73B9EE75}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
