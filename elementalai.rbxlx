			<Item class="Script" referent="RBX4372531CA32247128DFEE6C96E07C384">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local ProjectileMod = require(game.ReplicatedStorage.Loader.Shared.Modules.Projectiles)
local vectorMod = require(game.ReplicatedStorage.Loader.Shared.Modules.Vectors)
local debounce = false

function Shoot(pos, vel)
	if debounce then return end
	
	debounce = true
	task.delay(.1, function()
		debounce = false
	end)
	
	local Projectile = ProjectileMod.new()
	
	Projectile.Lifetime = 1
	Projectile.Health = 10
	Projectile.Ricochets = 0
	Projectile.Knockback = 150
	Projectile.HomingStrength = .5
	Projectile.RicochetAutoAimCone = 0
	Projectile.HomingCone = 360
	Projectile.SlitherIntensity = 0
	Projectile.SlitherDuration = .2
	Projectile.SlitherCooldown = 0
	Projectile.ExplodeOnDeath = true
	Projectile.ExplosionRadius = 10
	Projectile.ExplosionKnockback = 200
	Projectile.ExplosionDamage = 25
	Projectile.Gravity = 0
	Projectile.MaxSpeed = 1000
	Projectile.HitProjectiles = true
	Projectile.HomeToCharacters = true
	Projectile.HomeToProjectiles = false	
	--Projectile.HitSelf = true
	Projectile.Owner = script.Parent.Parent
	Projectile:CreateProjectile({
		["Position"] = pos,
		["Velocity"] = vel	
	})
end

script.Parent.ShootEvent.OnServerEvent:Connect(function(plr, args)
	if plr.Character ~= script.Parent.Parent then
		return
	end
	local tool = script.Parent
	for count = 1, 1, 1 do
		task.spawn(function()
			--[[Shoot(script.Parent.Handle.Position + vectorMod.RandomOffsetInRange({
				Range = 10,
				InitialLook = script.Parent.Handle.CFrame.UpVector,
				XMaxAngle = 180,
				YMaxAngle = 180
				
			}), Vector3.new(0,0,0))]]
			Shoot(args.HandleCF.Position, args.HRPCF.LookVector * 500)
		end)
		
	end
end)]]></ProtectedString>
