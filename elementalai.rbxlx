					<Item class="ModuleScript" referent="RBX804250D8C2B44C4B815E550E66BC09A2">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local module = {}

-- DealDamage
export type DealDamage = {
	Damage:number, 
	Target:Instance,
	Attacker:Instance,
	TriggerEvents:boolean,
}
local DefaultDealDamage = {
	Damage = 0,
	Target = nil,
	Attacker = nil,
	TriggerEvents = true
}
function module.DealDamage(config:DealDamage)
	setmetatable(config, {__index = DefaultDealDamage})

	local damage = config.Damage
	local target = config.Target
	local attacker = config.Attacker

	if not target then return end

	if damage == 0 then return end
	
	local atkEvent:BindableEvent =  config.TriggerEvents and attacker and attacker:FindFirstChild("Events") and attacker.Events:FindFirstChild("DealDamage")
	local takeEvent:BindableEvent = config.TriggerEvents and target and target:FindFirstChild("Events") and target.Events:FindFirstChild("TakeDamage")
	
	if atkEvent then
		atkEvent:Fire(config)
	end
	if takeEvent then
		takeEvent:Fire(config)
	end
	
	target:SetAttribute("Health", math.clamp(target:GetAttribute("Health") - damage, 0, math.huge))
end


-- DealKnockback
export type DealKnockback = {
	Knockback:Vector3, 
	Target:Instance,
	Attacker:Instance,
	AffectedByScale:boolean,
}
local DefaultDealKnockback = {
	Knockback = Vector3.new(0,0,0),
	Target = nil,
	Attacker = nil,
}
function module.DealKnockback(config:DealKnockback)
	setmetatable(config, {__index = DefaultDealKnockback})

	local knockback = config.Knockback
	local target = config.Target
	local attacker = config.Attacker

	if knockback == 0 then return end

	if not target then return end

	local hrp:BasePart = (target:IsA("BasePart") and target:GetAttribute("DebrisVelocity") and target) or target.PrimaryPart
	local hrpAnchored = hrp.Anchored
	if hrp then hrp.Anchored = false end


	if target:FindFirstChild("DashVelocity") then
		target.DashVelocity.Enabled = false
	end

	if target:GetAttribute("DebrisVelocity") then
		target:SetAttribute("DebrisVelocity", target:GetAttribute("DebrisVelocity") + knockback)
		if not hrp:IsGrounded() then
			hrp:ApplyImpulse(knockback)
		end
	else
		hrp.AssemblyLinearVelocity += knockback
	end

	hrp.Anchored = hrpAnchored
end

return module
]]></ProtectedString>
