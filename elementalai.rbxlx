							<Properties>
								<Content name="LinkedSource"><null></null></Content>
								<ProtectedString name="Source"><![CDATA[
local Loader = game.ReplicatedStorage.Loader

function Event(event, functionToRun)
	event.OnServerEvent:Connect(functionToRun)
end
return function()
	Event(Loader.ClientSide.Modules.OnJoin.ChangeGravityDirectionEvent, function(plr, direction)
		plr.Character:SetAttribute("GravityDirection", direction)
		--print(plr.Character:GetAttribute("GravityDirection"))
	end)
end
]]></ProtectedString>
								<string name="ScriptGuid">{81D3CBCB-FD08-490A-B4F3-D7DE2EE981F7}</string>
								<BinaryString name="AttributesSerialize"></BinaryString>
								<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
								<bool name="DefinesCapabilities">false</bool>
								<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
								<string name="Name">ClientStatChangeEvents</string>
								<int64 name="SourceAssetId">-1</int64>
								<BinaryString name="Tags">U2VydmVySW5pdGlhbGl6ZQ==</BinaryString>
								<UniqueId name="UniqueId">085346608a0504f2099d48af00004c6c</UniqueId>
							</Properties>
