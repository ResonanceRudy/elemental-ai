							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local module = {}

type TeleportConfig = {
	PlaceId: number,
	Players: {Player},
	ShouldReserveServer: boolean,
	AccessCode: string?,
	TeleportData:{any}
}
function module.Teleport(config:TeleportConfig)
	local Options = Instance.new("TeleportOptions")
	Options.ShouldReserveServer = config.ShouldReserveServer or true
	Options.ReservedServerAccessCode = config.AccessCode
	Options:SetTeleportData(config.TeleportData)
	
	local success, err = pcall(function()
		return game:GetService("TeleportService"):TeleportAsync(config.PlaceId, config.Players)
	end)
	
	if not success then
		warn("Teleport failed: "..err)
	end
end

return module
]]></ProtectedString>
