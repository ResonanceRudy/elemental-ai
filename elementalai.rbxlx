				<Item class="Script" referent="RBX7A7901E672784097B20196F8A0337F04">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local char = script.Parent.Parent
local events = char:FindFirstChild("Events")
local atkEvent:BindableEvent = events and events:FindFirstChild("DealDamage")
local takeEvent:BindableEvent = events and events:FindFirstChild("TakeDamage")

for i, v in pairs(char:GetChildren()) do
	if v:IsA("BasePart") then
		local frozenEffect = script.FrozenEffect:Clone()
		frozenEffect.Parent = v
		frozenEffect.Enabled = true
		
		local snowflakeEffect = script.SnowflakeEffect:Clone()
		snowflakeEffect.Parent = v
		snowflakeEffect.Enabled = true
	end
end

function OnHitFunction(config)
	local debuffScript = game.ReplicatedStorage.DebuffScripts.Server.Freezing:Clone()

	debuffScript:SetAttribute("Duration", 1 + config.Damage/20)
	debuffScript.Owner.Value = config.Attacker
	debuffScript.Parent = config.Target:FindFirstChild("Debuffs") or config.Target
	
	local target = config.Target
	if target:GetAttribute("Health") - config.Damage <= 0 then
		if target:IsA("BasePart") then
			target.Material = Enum.Material.Ice
		else
			for i, v in target:GetChildren() do
				if v:IsA("BasePart") then
					v.Material = Enum.Material.Ice
				end
			end
		end
	end
end

if atkEvent then
	atkEvent.Event:Connect(OnHitFunction)
end]]></ProtectedString>
