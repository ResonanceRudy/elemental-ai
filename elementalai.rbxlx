							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Sounds</string>
							<int64 name="SourceAssetId">-1</int64>
							<BinaryString name="Tags"></BinaryString>
							<UniqueId name="UniqueId">6d436cc27613dc5b099c055800003907</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXF77E7A80A6A546BAA51A0F08D28CA56E">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local module = {}

function module.Merge(listOfTables)
	local unpackedTable = {}
	for _, currentTable in listOfTables do
		for _, value in currentTable do
			table.insert(unpackedTable, value)
		end
	end
	return unpackedTable
end

return module
]]></ProtectedString>
							<string name="ScriptGuid">{173BA1CF-FCE5-48E3-81E9-A6148C4E2770}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Tables</string>
							<int64 name="SourceAssetId">-1</int64>
							<BinaryString name="Tags"></BinaryString>
							<UniqueId name="UniqueId">6d436cc27613dc5b099c055800003908</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0A286BDB4CA049938E84F83DAC44B830">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local module = {
	Colors = {
		["Red"] = Color3.fromRGB(255, 0, 0),
		["Blue"] = Color3.fromRGB(0, 98, 255),
		["Green"] = Color3.fromRGB(0, 149, 0),
		["Yellow"] = Color3.fromRGB(255, 255, 0),
		["Orange"] = Color3.fromRGB(255, 128, 0),
		["Purple"] = Color3.fromRGB(98, 0, 130),
		["Pink"] = Color3.fromRGB(255, 105, 180),
		["White"] = Color3.fromRGB(255,255,255),
		["Black"] = Color3.fromRGB(0,0,0),
		["Brown"] = Color3.fromRGB(139, 69, 19),
		["Cyan"] = Color3.fromRGB(0, 255, 255),
		["Navy"] = Color3.fromRGB(0, 0, 128),
		["Grey"] = Color3.fromRGB(128, 128, 128)
	},
	Teams = {
		None = {
			Allies = {"Spectator"},
			SelfEnemy = true,
			Color = Color3.fromRGB(255,255,255)
		}
	}
}
local CS = game:GetService("CollectionService")
local RS = game:GetService("RunService")
local tableMod = require(script.Parent.Tables)
local vectorMod = require(script.Parent.Vectors)
local queryMod = require(script.Parent.Queries)

type AddTeamConfig = {
	TeamName:string,
	TeamColor:Color3,
	Allies:{string},
	SelfEnemy:boolean
}

function module.AddTeam(config:AddTeamConfig)
	local newTeam = {
		Allies = config.Allies or {"Spectator"},
		SelfEnemy = config.SelfEnemy or false,
		Color = config.TeamColor or Color3.fromRGB(255,255,255)
	}
	
	module.Teams[config.TeamName] = newTeam
	if RS:IsServer() then
		script.UpdateTeamEvent:FireAllClients("AddTeam", config)
	end
	return module.Teams[config.TeamName]
end

type RemoveTeamConfig = {
	TeamName:string,
}
function module.RemoveTeam(config:RemoveTeamConfig)
	module.Teams[config.TeamName] = nil
	if RS:IsServer() then
		script.UpdateTeamEvent:FireAllClients("RemoveTeam", config)
	end
end

function module.IsAlly(team1Name, team2Name)
	if typeof(team1Name) == "Instance" then
		team1Name = team1Name:GetAttribute("Team")
	end
	if typeof(team2Name) == "Instance" then
		team2Name = team2Name:GetAttribute("Team")
	end

	local team1 = module.Teams[team1Name] or (team1Name and module.AddTeam({TeamName = team1Name}))
	local team2 = module.Teams[team2Name] or (team2Name and module.AddTeam({TeamName = team2Name}))
	
	if (team1 and team2) then
		return table.find(team1.Allies, team2Name) or table.find(team2.Allies, team1Name) or (team1Name == team2Name and team1.SelfEnemy == false) 
	else
		return true
	end
end

type RegisterHitConfig = {
	Team:string,
	Attacker:Model,
	Target:Model,
	
	HitSelf:boolean,
	HitEnemies:boolean,
	HitAllies:boolean,
	HitProjectiles:boolean,
	HitCharacters:boolean,
	
	FilterType:string,
	FilterDescendantsInstances:{Instance},
}
function module.RegisterHit(config:RegisterHitConfig)
	if not config.FilterDescendantsInstances then config.FilterDescendantsInstances = {} end
	local v = config.Target
	
	local isAlly = module.IsAlly(config.Team, v:GetAttribute("Team"))

	local characterCheck = v:HasTag("Character") and (config.HitCharacters == nil or config.HitCharacters)
	local projectileCheck = (v:HasTag("Projectile") and (config.HitProjectiles == nil or config.HitProjectiles) and v:FindFirstChild("Owner") and v.Owner.Value ~= config.Attacker)
	local allyCheck = (isAlly and config.HitAllies and v ~= config.Attacker)
	local enemyCheck = ((isAlly == false) and (config.HitEnemies == nil or config.HitEnemies) and v ~= config.Attacker)
	local selfCheck = (v == config.Attacker and config.HitSelf)
	

	if not((allyCheck or enemyCheck or selfCheck) and (projectileCheck or characterCheck)) or (config.FilterType == "Include" and not table.find(config.FilterDescendantsInstances, v)) or ((config.FilterType == "Exclude" or config.FilterType == nil) and table.find(config.FilterDescendantsInstances, v)) or not v:IsDescendantOf(workspace) or not v:GetAttribute("Health") or v:GetAttribute("Health") <= 0 then
		return false
	else
		if v.Name == "Assault" then
			--print(tostring(config.Attacker).." register hit to Assault: true. Attacker team: "..tostring(config.Team).." | Target team: "..tostring(v:GetAttribute("Team")))
		end
		return true
	end
end
type FindTargetConfig = {
	Team:string,
	Attacker:Model,
	
	HitSelf:boolean,
	HitEnemies:boolean,
	HitAllies:boolean,
	HitProjectiles:boolean,
	
	FilterType:string,
	FilterDescendantsInstances:{Instance},
	
	LookVector:Vector3,
	Position:Vector3,
	Range:number,
	FOV:number,
	FOVFocus:boolean,
	SeeThroughWalls:boolean,
}

function module.FindTarget(config:FindTargetConfig)
	local chars = CS:GetTagged("Character")
	local projectiles = CS:GetTagged("Projectile")
	local totalTargets = tableMod.Merge({chars, projectiles})
	
	local shift = 0
	
	for i,v in table.clone(totalTargets) do
		local registerConfig = config
		registerConfig.Target = v
		
		if module.RegisterHit(registerConfig) then
			local enemyPos = v.PrimaryPart.Position
			local distance = (config.Position-enemyPos).Magnitude
			local rayResult
			
			if not config.SeeThroughWalls then
				rayResult = queryMod.Raycast({
					["CollisionGroup"] = "MapOnly",
					["RaycastType"] = "Raycast",
					["Origin"] = config.Position,
					["Direction"] = (enemyPos - config.Position),
					["MaxDistance"] = distance
				})
			end
			
			
			if not (distance <= config.Range and vectorMod.GetAngle((enemyPos - config.Position), config.LookVector) < config.FOV/2) or (config.FilterType == "Exclude" and table.find(config.FilterDescendantsInstances, v)) or (config.FilterType == "Include" and not table.find(config.FilterDesce)) or (not config.SeeThroughWalls and rayResult) then
				table.remove(totalTargets, i - shift)
				shift += 1
			end
		else
			table.remove(totalTargets, i - shift)
			shift += 1
		end
	end
	
	local nearestTarget
	local nearestDistance = math.huge
	local falseDistance = math.huge
	for i, v in totalTargets do
		local distance = (v.PrimaryPart.Position - config.Position).Magnitude
		local actualDistance = distance
		
		if config.FOVFocus == true or config.FOVFocus == nil then
			local angle = vectorMod.GetAngle((v.PrimaryPart.Position - config.Position), config.LookVector)
			distance *= (1 - (angle / (config.FOV/2)))
		end
		
		if distance < falseDistance then
			nearestDistance = actualDistance
			falseDistance = distance
			nearestTarget = v
		end
	end
	
	return nearestTarget, nearestDistance
end

return module
]]></ProtectedString>
