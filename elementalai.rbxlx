					<Item class="ModuleScript" referent="RBXBC5BB49E0CC44A8899FC44686375C04A">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local module = {}
local RS  = game:GetService("RunService")
local Loader = game.ReplicatedStorage:WaitForChild("Loader")
local combatMod = require(Loader.Shared.Modules.SharedCombat)
local explosionMod = require(Loader.Shared.Modules.Explosions)
local serverCombatMod
local statsMod
if RS:IsServer() then
	serverCombatMod = require(game.ServerStorage:WaitForChild("ServerSide").Modules.ServerCombat)
	statsMod = require(game.ServerStorage:WaitForChild("ServerSide").Modules.CharacterStats)
end

local teamMod = require(Loader.Shared.Modules.Teams)
local tableMod = require(Loader.Shared.Modules.Tables)
local vectorMod = require(Loader.Shared.Modules.Vectors)


local CS = game:GetService("CollectionService")

function module.new()
	return setmetatable({
		Damage = 20, 
		Health = 20,
		
		Gravity = 1,
		MaxSpeed = 200,
		
		HomingCone = 90,
		HomingStrength = 0, 
		HomingRange = 500,
		HomeToCharacters = true,
		HomeToProjectiles = false,
		HomingTargetChangeCooldown = 0.5,
		
		SlitherIntensity = 0,
		SlitherDuration = .2,
		SlitherCooldown = 0,
		
		Knockback = 75,
		KnockbackVelocityInfluence = Vector3.new(1,0,1),
		KnockbackDirectionAddition = Vector3.new(0,0.5,0),
		
		ExplodeOnDeath = false,
		ExplodeOnRicochet = false,
		ExplodeOnCharHit = false,
		ExplodeOnProjectileHit = false,
		ExplosionDamage = 0,
		ExplosionKnockback = 75,
		ExplosionRadius = 10,
		
		Lifetime = 10, 
		
		Ricochets = 0,
		RicochetAutoAimCone = 0,
		RicochetAutoAimRange = 500,
		
		Team = "None",
		Owner = nil,
		
		HitEnemies = true,
		HitAllies = false,
		HitSelf = false,
		HitProjectiles = true,
		HitCharacters = true,
		
		Size = Vector3.new(.5,.5,.5),
		Shape = Enum.PartType.Ball
		
	}, {__index = module})
end

type CreateProjectileConfig = {
	Velocity:Vector3,
	Position:Vector3
}
function module:CreateProjectile(config:CreateProjectileConfig)
	local projectile = game.ReplicatedStorage:WaitForChild("Loader").Shared.Assets.Projectile:Clone()
	
	for i, v in self do
		if (type(v) == "string" or type(v) == "number" or type(v) == "boolean" or type(v) == "vector") and projectile:GetAttribute(i) ~= nil then
			projectile:SetAttribute(i, v) 
		end
	end

	local hitbox = projectile:WaitForChild("Hitbox")
	local pos = config.Position or Vector3.new(0,0,0)
	local vel = (config.Velocity or Vector3.new(0,0,0)) + Vector3.new(.01,0,0)
	
	hitbox.CFrame = CFrame.new(pos, pos + (vel or Vector3.new(0,0,1)))
	hitbox.AssemblyLinearVelocity = vel
	
	hitbox.Size = self.Size
	hitbox.Shape = self.Shape
	
	local lastPosition = pos

	local projectileFolder = workspace:FindFirstChild("Projectiles") or Instance.new("Folder")
	if not workspace:FindFirstChild("Projectiles") then
		projectileFolder.Name = "Projectiles"
		projectileFolder.Parent = workspace 
	end

	projectile.Parent = projectileFolder
	
	local newName
	repeat 
		newName = projectile.Name..tostring(math.random(1,1000000000))
		if not projectile.Parent:FindFirstChild(newName) then
			break
		end
	until false
	projectile.Name = newName

	local function UpdateGravity()
		local gravity = -workspace.Gravity * projectile:GetAttribute("Gravity")

		local mass = 0
		for _, part in projectile:GetChildren() do
			if part:IsA("BasePart") then
				mass += part:GetMass()
			end
		end

		local force = projectile.GravityForce
		force.Force = Vector3.new(0, mass * gravity, 0) + Vector3.new(0, mass * workspace.Gravity, 0)
	end
	UpdateGravity()
	
	projectile.AttributeChanged:Connect(function(attributeName)
		if attributeName == "Gravity" then
			UpdateGravity()
		end
	end)
	
	local function UpdateNWOwner(value)
		local plr = game.Players:GetPlayerFromCharacter(value)
		if plr then
			hitbox:SetNetworkOwner(plr)
			script.ClientHitboxEvent:FireClient(plr, {ProjectileName = projectile.Name, ProjectileParent = projectile.Parent})
		else
			hitbox:SetNetworkOwner(nil)
		end
		script.ClientSideProjectileEvent:FireAllClients({ProjectileName = projectile.Name, ProjectileParent = projectile.Parent})
	end
	
	projectile.Owner.Value = self.Owner
	projectile.Owner.Changed:Connect(UpdateNWOwner)
	UpdateNWOwner(self.Owner)
	
	projectile.Events.RunOnServerEvent.OnServerEvent:Connect(function(plr, functionName, argTable)
		if plr == game.Players:GetPlayerFromCharacter(projectile.Owner.Value) then
			module[functionName](argTable)
		end
		if game.Players:GetPlayerFromCharacter(projectile.Owner.Value) == nil and (functionName == "HitCharacter" or functionName == "HitProjectile") and argTable.Target == plr.Character then
			module[functionName](argTable)
		end
	end)
	
	local hitAlready = {}
	
	local HitEventFunction = function(targetHit)
		if targetHit and not table.find(hitAlready, targetHit) then
			table.insert(hitAlready, targetHit)
			if targetHit:IsA("BasePart") and targetHit.CollisionGroup == "Map" then
				hitAlready = {targetHit}
				task.delay(0, function()
					table.remove(hitAlready, table.find(hitAlready, targetHit))
				end)
			end
		end
	end
	projectile.Events.HitEvent.Event:Connect(HitEventFunction)

	
	-- Only create individual Heartbeat connection for client-owned projectiles
	-- Server projectiles are handled by the centralized ProjectilesServer module
	script.ProjectileBindableEvent:Fire(projectile)
	return projectile
end

type UpdateProjectileConfig = {
	Projectile:Model,
	LastProjectilePosition:Vector3,
	HitAlready:{Instance},
	DeltaTime:number,
	TimeAtHomingTargetChange:number,
	HomingTarget:Instance
}

function module.UpdateProjectile(config:UpdateProjectileConfig)
	
	-- setting variables from config
	local projectile = config.Projectile
	local hitbox = projectile:FindFirstChild("Hitbox")
	local lastPosition = config.LastProjectilePosition
	local hitAlready = config.HitAlready or {}
	local deltaTime = config.DeltaTime or 1/60
	local homingTarget = config.HomingTarget
	
	config.TimeAtHomingTargetChange = config.TimeAtHomingTargetChange or time()
	
	if not projectile or not hitbox then
		return {
			HitAlready = hitAlready,
			LastPosition = lastPosition
		}
	end
	
	projectile.AlignOrientation.CFrame = CFrame.lookAt(hitbox.Position, hitbox.Position + hitbox.AssemblyLinearVelocity)

	local chars = CS:GetTagged("Character")
	local projectiles = CS:GetTagged("Projectile")
	local homingTable = {}
	if projectile:GetAttribute("HomeToCharacters") then
		homingTable = tableMod.Merge({homingTable, chars})
	end
	if projectile:GetAttribute("HomeToProjectiles") then
		homingTable = tableMod.Merge({homingTable, projectiles})
	end
	
	local exlusions = {}
	
	local function CheckForExclude(enemy)
		if ((enemy and (table.find(hitAlready, enemy) or not enemy:IsDescendantOf(workspace))) or (not teamMod.RegisterHit({Attacker = projectile.Owner.Value, Team = projectile:GetAttribute("Team"), Target = enemy, HitAllies = projectile:GetAttribute("HitAllies"), HitEnemies = projectile:GetAttribute("HitEnemies"), HitProjectiles = projectile:GetAttribute("HitProjectiles"), HitSelf = projectile:GetAttribute("HitSelf"), HitCharacters = projectile:GetAttribute("HitCharacters")})) or enemy == projectile or not enemy:GetAttribute("Health") or enemy:GetAttribute("Health") <= 0 or (enemy:HasTag("Projectile") and (not enemy:FindFirstChild("Owner") or not projectile:FindFirstChild("Owner") or enemy.Owner.Value == projectile.Owner.Value))) then
			return true
		else
			--print(enemy.Name.." not excluded. registerhit: "..tostring(teamMod.RegisterHit({Attacker = projectile.Owner.Value, Team = projectile:GetAttribute("Team"), Target = enemy, HitAllies = projectile:GetAttribute("HitAllies"), HitEnemies = projectile:GetAttribute("HitEnemies"), HitProjectiles = projectile:GetAttribute("HitProjectiles"), HitSelf = projectile:GetAttribute("HitSelf")})))
			return false
		end
	end
	
	local changedTarget = false
	if config.TimeAtHomingTargetChange + projectile:GetAttribute("HomingTargetChangeCooldown") >= time() then
		changedTarget = true
		config.TimeAtHomingTargetChange = time()
		local shift = 0
		for i, v in table.clone(homingTable) do
			if v and CheckForExclude(v) then
				table.remove(homingTable, i - shift)
				shift += 1
			end
		end
	end
	
	-- Homing
	if projectile:GetAttribute("HomingStrength") ~= 0 then
		if changedTarget then
			local distanceToNearest = math.huge
			for i, v in homingTable do
				if not v.PrimaryPart then continue end
				local distance = (v.PrimaryPart.Position - hitbox.Position).Magnitude
				local angle = vectorMod.GetAngle(hitbox.AssemblyLinearVelocity, v.PrimaryPart.Position - hitbox.Position)
				
				if distance and distance < distanceToNearest and angle <= projectile:GetAttribute("HomingCone")/2 and distance < projectile:GetAttribute("HomingRange") and ((v:HasTag("Character") and projectile:GetAttribute("HomeToCharacters")) or (v:HasTag("Projectile") and projectile:GetAttribute("HomeToProjectiles")))then
					distanceToNearest = distance
					homingTarget = v
				end
			end
		end
		
		local distanceToNearest = (homingTarget and homingTarget.PrimaryPart and (homingTarget.PrimaryPart.Position - hitbox.Position).Magnitude) or math.huge
		if homingTarget and distanceToNearest < projectile:GetAttribute("HomingRange") then
			local pushDirection = (homingTarget.PrimaryPart.Position - hitbox.Position).Unit
			local currentVel = hitbox.AssemblyLinearVelocity
			local velDirection = currentVel.Unit
			local targetVel = projectile:GetAttribute("MaxSpeed") * pushDirection * math.sign(projectile:GetAttribute("HomingStrength"))
			local reflectedVelDirection = (-velDirection - (2 * -math.abs(-velDirection:Dot(pushDirection)) * pushDirection)).Unit 
			local dot = velDirection:Dot(pushDirection)
			
			--[[hitbox.AssemblyLinearVelocity += Vector3.new(math.clamp(math.sign(targetVel.X - currentVel.X) * math.abs(targetVel.X - currentVel.X), -projectile:GetAttribute("HomingStrength"), projectile:GetAttribute("HomingStrength")), 0, 0) 
			hitbox.AssemblyLinearVelocity += Vector3.new(0, math.clamp(math.sign(targetVel.Y - currentVel.Y) * math.abs(targetVel.Y - currentVel.Y), -projectile:GetAttribute("HomingStrength"), projectile:GetAttribute("HomingStrength")), 0) 
			hitbox.AssemblyLinearVelocity += Vector3.new(0, 0, math.clamp(math.sign(targetVel.Z - currentVel.Z) * math.abs(targetVel.Z - currentVel.Z), -projectile:GetAttribute("HomingStrength"), projectile:GetAttribute("HomingStrength"))) ]]
			
			hitbox.AssemblyLinearVelocity = currentVel:Lerp(targetVel, math.clamp(math.abs(projectile:GetAttribute("HomingStrength")) * (deltaTime/(1/60)) * (0.01 + .001 * math.clamp(dot * 10, 0, 10)), 0, 1))
			
			--hitbox.AssemblyLinearVelocity += pushDirection * projectile:GetAttribute("HomingStrength") * 0.25 + (reflectedVelDirection * projectile:GetAttribute("HomingStrength"))*0.75
		end
	end
	
	local currentVel = hitbox.AssemblyLinearVelocity
	if currentVel.Magnitude > projectile:GetAttribute("MaxSpeed") then
		hitbox.AssemblyLinearVelocity *= .99 ^ (deltaTime/(1/60))
	end
	
	local exploded = false
	local function Explosion()
		local hideServerExplosion = RS:IsServer() and not RS:IsRunMode()
		explosionMod.ExplosionHitDetection({
			Position = hitbox.Position,
			Radius = projectile:GetAttribute("ExplosionRadius"),
			Owner = projectile.Owner.Value,
			
			Damage = projectile:GetAttribute("ExplosionDamage"),
			Knockback = projectile:GetAttribute("ExplosionKnockback"),
			
			HitSelf = projectile:GetAttribute("HitSelf"),
			HitAllies = projectile:GetAttribute("HitAllies"),
			HitEnemies = projectile:GetAttribute("HitEnemies"),
			HitProjectiles = projectile:GetAttribute("HitProjectiles"),
			HitCharacters = projectile:GetAttribute("HitCharacters"),
			
			Team = projectile:GetAttribute("Team"),
			
			StartColor = hitbox.Color,
			MiddleColor = hitbox.Color,
			EndColor = hitbox.Color,
			
			StartTransparency = (hideServerExplosion and 1) or nil,
			MiddleTransparency = (hideServerExplosion and 1) or nil,
			EndTransparency = (hideServerExplosion and 1) or nil,
			
			FilterDescendantsInstances = {}
		})
		exploded = true
	end
	

	if lastPosition ~= hitbox.Position then
		local iterationCount = 0
		repeat
			iterationCount += 1
			local raycastConfig = {
				Attacker = projectile.Owner.Value,
				Team = projectile:GetAttribute("Team"),

				HitSelf = projectile:GetAttribute("HitSelf"),
				HitAllies = projectile:GetAttribute("HitAllies"),
				HitEnemies = projectile:GetAttribute("HitEnemies"),
				HitProjectiles = projectile:GetAttribute("HitProjectiles"),

				QueryType = "Raycast",

				RaycastConfig = {
					Origin = lastPosition,
					Direction = (hitbox.Position - lastPosition).Unit,
					MaxDistance = (hitbox.Position - lastPosition).Magnitude,

					FilterDescendantsInstances = exlusions,
					CollisionGroup = "HitboxWithMap",

					RaycastType = "Shapecast",
					Part = hitbox
				}
			}
			local result:RaycastResult
			local result2:RaycastResult
			
			result = combatMod.AreaDamage(raycastConfig)
			
			local newConfig = table.clone(raycastConfig)
			newConfig.RaycastConfig.RaycastType = "Raycast"
			if not result then
				result = combatMod.AreaDamage(newConfig)
			else
				result2 = combatMod.AreaDamage(newConfig)
			end
			

			local enemy = result and result.Instance.Parent
			--[[if result then
				print(result.Instance)
			end]]
			
			local originalProj = projectile
			if projectile:FindFirstChild("ProjectileRedirect") then
				projectile = projectile.ProjectileRedirect.Value
			end
			local exclude = false
			if (not enemy or CheckForExclude(enemy) or (game.Players:GetPlayerFromCharacter(enemy) and not game.Players:GetPlayerFromCharacter(projectile.Owner.Value) and RS:IsServer())) and (result and result.Instance.CollisionGroup ~= "Map") then
				
				exclude = true
			end
			if not exclude and enemy and not table.find(hitAlready, result.Instance) and projectile:GetAttribute("Health") > 0 then
				if enemy:HasTag("Character") then
					module.HitCharacter({
						["Projectile"] = projectile, 
						["Target"] = enemy,
					})
					
					if projectile:GetAttribute("ExplodeOnCharHit") then
						Explosion()
					end
					--[[if RS:IsClient() then
						print("client")
					else
						print("server")
					end]]
					table.insert(hitAlready, enemy)
					task.delay(1/math.clamp(projectile:GetAttribute("HomingStrength"), 0.01, math.huge), function()
						if table.find(hitAlready, enemy) then
							table.remove(hitAlready, table.find(hitAlready, enemy))
						end
					end)
				elseif enemy:HasTag("Projectile") and enemy ~= projectile and enemy.Owner.Value ~= projectile.Owner.Value then
					if enemy:FindFirstChild("ProjectileRedirect") then
						table.insert(hitAlready, enemy)
						enemy = enemy.ProjectileRedirect.Value
					end
					module.HitProjectile({
						["Projectile"] = projectile, 
						["Target"] = enemy
					})
					if projectile:GetAttribute("ExplodeOnProjectileHit") then
						Explosion()
					end
					table.insert(hitAlready, enemy)
				elseif result.Instance.CollisionGroup == "Map"  then
					module.HitMap({
						["Projectile"] = projectile, 
						["Result"] = result2 or result,
						["RayOrigin"] = raycastConfig.RaycastConfig.Origin,
						["HomingTargets"] = homingTable,
					})
					if projectile:GetAttribute("ExplodeOnRicochet") and projectile:GetAttribute("Ricochets") > 0 then
						Explosion()
					end
					
					hitAlready = {result.Instance}
					task.delay(0, function()
						table.remove(hitAlready, table.find(hitAlready, result.Instance))
					end)
					break
				else
					table.insert(hitAlready, result.Instance)
				end
			else
				if result and not table.find(hitAlready, result.Instance) then
					table.insert(hitAlready, result.Instance)
				end
				break
			end
			--projectile = originalProj
		until false
	end
	lastPosition = hitbox.Position
	
	if projectile:GetAttribute("Health") <= 0 and projectile:GetAttribute("ExplodeOnDeath") and exploded == false then
		Explosion()
		--[[if RS:IsClient() then
			print("boom.")
		end]]
	end
	return {
		HitAlready = hitAlready,
		LastPosition = lastPosition,
		TimeAtHomingTargetChanged = config.TimeAtHomingTargetChange,
		HomingTarget = homingTarget
	}
end



type HitCharConfig = {
	Target:Object,
	Projectile:Object
}
function module.HitCharacter(config:HitCharConfig)
	
	if RS:IsServer() then
		local enemy = config.Target
		local projectile = config.Projectile
		local hitbox = projectile.Hitbox
		
		local isAlly = teamMod.IsAlly(projectile, enemy)
		if ((isAlly and not projectile:GetAttribute("HitAllies") and enemy ~= projectile.Owner.Value) or (not isAlly and not projectile:GetAttribute("HitEnemies")) or (enemy == projectile.Owner.Value and not projectile:GetAttribute("HitSelf")) or (enemy:HasTag("Projectile") and not projectile:GetAttribute("HitProjectiles"))) or enemy == projectile then
			return
		end

		local damage = statsMod.ApplyMultipliers({Char = projectile.Owner.Value, OtherChar = enemy, StatName = "Damage", Value = projectile:GetAttribute("Damage")})
		local knockback = statsMod.ApplyMultipliers({Char = projectile.Owner.Value, OtherChar = enemy, StatName = "Knockback", Value = projectile:GetAttribute("Knockback")})
		local damageDealt = (enemy:GetAttribute("Health") < damage and enemy:GetAttribute("Health")) or damage

		local knockbackDirection = (hitbox.AssemblyLinearVelocity.Unit * projectile:GetAttribute("KnockbackVelocityInfluence") + projectile:GetAttribute("KnockbackDirectionAddition")).Unit
		serverCombatMod.DealDamage({
			["Target"] = enemy,
			["Damage"] = damage,
		})
		serverCombatMod.DealKnockback({
			["Target"] = enemy,
			["Knockback"] = knockback * knockbackDirection

		})

		projectile:SetAttribute("Health", math.clamp(projectile:GetAttribute("Health") - damageDealt, 0, math.huge))
		if projectile:GetAttribute("Health") > 0 then
			projectile:SetAttribute("Lifetime", projectile:GetAttribute("Lifetime") + 1)
		end
		if game.Players:GetPlayerFromCharacter(projectile.Owner.Value) then
			projectile.Events.HitEvent:Fire(enemy)
		end
	else
		config.Projectile.Events.RunOnServerEvent:FireServer("HitCharacter", config)
	end
end



type HitProjConfig = {
	Target:Object,
	Projectile:Object
}
function module.HitProjectile(config:HitProjConfig)
	if RS:IsServer() then
		local projectile = config.Projectile
		local enemy = config.Target
		
		local isAlly = teamMod.IsAlly(projectile, enemy)
		if ((isAlly and not projectile:GetAttribute("HitAllies") and enemy ~= projectile.Owner.Value) or (not isAlly and not projectile:GetAttribute("HitEnemies")) or (enemy.Owner.Value == projectile.Owner.Value) or (enemy:HasTag("Projectile") and not projectile:GetAttribute("HitProjectiles"))) or enemy == projectile then
			return
		end

		enemy:SetAttribute("Health", math.clamp(enemy:GetAttribute("Health") - projectile:GetAttribute("Damage"), 0, math.huge))
		projectile:SetAttribute("Health", math.clamp(projectile:GetAttribute("Health") - enemy:GetAttribute("Damage"), 0, math.huge))

		local enemyHitbox = enemy.PrimaryPart
		local hitbox = projectile.PrimaryPart
		if projectile:GetAttribute("Health") > 0 then
			projectile:SetAttribute("Lifetime", projectile:GetAttribute("Lifetime") + 1)
			if hitbox then
				projectile.PrimaryPart.AssemblyLinearVelocity += enemy:GetAttribute("Knockback") * (hitbox.Position - enemyHitbox.Position).Unit
			end
			if enemyHitbox then
				enemyHitbox.AssemblyLinearVelocity += projectile:GetAttribute("Knockback") * (enemyHitbox.Position - hitbox.Position).Unit
			end
		end
		
		if game.Players:GetPlayerFromCharacter(projectile.Owner.Value) then
			projectile.Events.HitEvent:Fire(enemy)
		end
	else
		config.Projectile.Events.RunOnServerEvent:FireServer("HitProjectile", config)
	end
end



type HitMapConfig = {
	Projectile:Object,
	-- do something like this: Result:RaycastResult or {Object}
	Result:any,
	PartHit:BasePart,
	RayOrigin:RaycastResult|{Object},
	HomingTargets:{Object},
	AttributesToSet:{any}
}
function module.HitMap(config:HitMapConfig)
	local projectile = config.Projectile
	local result = config.Result
	local hitbox = projectile.Hitbox
	
	if not config.AttributesToSet then
		if projectile:GetAttribute("Ricochets") > 0 then
			if not projectile:GetAttribute("RicochetDebounce") then
				local currentVel = hitbox.AssemblyLinearVelocity
				local currentVelUnit = currentVel.Unit
				local currentSpeed = currentVel.Magnitude
				local normal = result.Normal
				local newDirection = (currentVelUnit - (2 * currentVelUnit:Dot(normal) * normal)).Unit
				
				if projectile:GetAttribute("RicochetAutoAimCone") > 0 then
					local nearestTarget 
					local distanceToNearest = math.huge
					
					for i, v in config.HomingTargets do
						if not v.PrimaryPart then continue end
						local distance = (v.PrimaryPart.Position - hitbox.Position).Magnitude
						local angle = vectorMod.GetAngle(newDirection, v.PrimaryPart.Position - hitbox.Position)

						if distance and distance < distanceToNearest and angle <= projectile:GetAttribute("RicochetAutoAimCone")/2 and distance < projectile:GetAttribute("RicochetAutoAimRange") and ((v:HasTag("Character") and projectile:GetAttribute("HomeToCharacters")) or (v:HasTag("Projectile") and projectile:GetAttribute("HomeToProjectiles")))then
							distanceToNearest = distance
							nearestTarget = v
						end
					end
					
					if nearestTarget then
						newDirection = (nearestTarget.PrimaryPart.Position - hitbox.Position).Unit
					end
				end

				hitbox.CFrame = CFrame.lookAlong(result.Position, newDirection)
				hitbox.AssemblyLinearVelocity = newDirection * currentSpeed

				projectile.AlignOrientation.CFrame = CFrame.lookAlong(config.RayOrigin, newDirection)
				
				
				config.AttributesToSet = {
					["Ricochets"] = projectile:GetAttribute("Ricochets") - 1,
					["Lifetime"] = projectile:GetAttribute("Lifetime") + 3,
					["HitAlready"] = result.Instance
				}
				config.PartHit = result.Instance
				if RS:IsServer() then
					module.HitMap(config)
				else
					config.Projectile.Events.RunOnServerEvent:FireServer("HitMap", config)
				end
			end
		else
			projectile:SetAttribute("Health", 0)
			hitbox.CFrame = CFrame.lookAlong(result.Position, hitbox.AssemblyLinearVelocity.Unit)
			
			config.AttributesToSet = {
				["Health"] = 0,
				["HitAlready"] = result.Instance
			}
			config.PartHit = result.Instance
			if not RS:IsServer() then
				config.Projectile.Events.RunOnServerEvent:FireServer("HitMap", config)
			else
				module.HitMap(config)
			end
		end	
	else
		for i, v in config.AttributesToSet do
			if i == "HitAlready" then
				--if game.Players:GetPlayerFromCharacter(projectile.Owner.Value) then
					projectile.Events.HitEvent:Fire(v)
				--end
			else
				projectile:SetAttribute(i, v)
			end
		end
		local part = config.PartHit
		if part and part:GetAttribute("Health") then
			serverCombatMod.DealDamage({
				["Attacker"] = projectile.Owner.Value,
				["Target"] = part,
				["Damage"] = projectile:GetAttribute("Damage")
			})
			serverCombatMod.DealKnockback({
				["Attacker"] = projectile.Owner.Value,
				["Target"] = part,
				["Knockback"] = part.AssemblyLinearVelocity.Unit * projectile:GetAttribute("Knockback")
			})
		end
	end		
end
return module
