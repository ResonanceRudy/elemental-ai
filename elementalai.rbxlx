							<string name="ScriptGuid">{98AEC1C7-797C-4466-A087-75D10F6E3244}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">ExplosionServer</string>
							<int64 name="SourceAssetId">-1</int64>
							<BinaryString name="Tags">U2VydmVySW5pdGlhbGl6ZQ==</BinaryString>
							<UniqueId name="UniqueId">6d436cc27613dc5b099c05580000392d</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX0981E44626AF48A99628F07955726303">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local Loader = game.ReplicatedStorage:WaitForChild("Loader")
local ProjectileMod = require(Loader.Shared.Modules.Projectiles)
local combatMod = require(Loader.Shared.Modules.SharedCombat)
local teamMod = require(Loader.Shared.Modules.Teams)

local CS = game:GetService("CollectionService")
local RS = game:GetService("RunService")

-- Centralized projectile management for server
local activeProjectiles = {}
local heartbeatConnection = nil

local activeStep = 0

-- Initialize the single Heartbeat connection
local function initializeHeartbeat()
	if heartbeatConnection then return end
	
	heartbeatConnection = RS.Heartbeat:Connect(function(delta)
		
		activeStep += delta
		if activeStep >= 0.02 then
			activeStep = 0
			-- Update active projectiles
			local shift = 0
			for i, projectileData in table.clone(activeProjectiles) do
				local projectile = projectileData.Projectile
				
				
				-- Check if should be removed
				if not (projectile and projectile:GetAttribute("Health") > 0 and time() - projectileData.TimeCreated < projectile:GetAttribute("Lifetime")) then
					table.remove(activeProjectiles, i - shift)
					shift += 1
					-- Clean up projectile
					if projectile then
						--print("projectile check:"..tostring(projectile ~= nil)..". Projectile health check: "..tostring(projectile:GetAttribute("Health") > 0)..". Projectile lifetime check: "..tostring(time() - projectileData.TimeCreated < projectile:GetAttribute("Lifetime")))
						
						if projectile:FindFirstChild("Hitbox") then
							projectile.Hitbox.Anchored = true
						end
						
						for i, v in projectile:GetDescendants() do
							if v:IsA("BasePart") then
								v.CanCollide = false
								v.CanQuery = false
								v.Transparency = 1
							end
						end
						task.delay(3, function()
							projectile:Destroy()
						end)
					end
					continue
				end
				
				if not game.Players:GetPlayerFromCharacter(projectile.Owner.Value) then
					local hitbox = projectileData.Hitbox
					
					if projectile and not game.Players:GetPlayerFromCharacter(projectile.Owner.Value) then
						-- Update projectile attributes
						projectile:SetAttribute("CurrentCFrame", hitbox.CFrame)
						projectile:SetAttribute("CurrentVelocity", hitbox.AssemblyLinearVelocity)

						-- Handle slithering for non-player-owned projectiles
						if not game.Players:GetPlayerFromCharacter(projectile.Owner.Value) then
							if not projectileData.Slithering and hitbox then
								task.spawn(function()
									local intensity = projectile:GetAttribute("SlitherIntensity")
									local duration = projectile:GetAttribute("SlitherDuration")
									local cooldown = projectile:GetAttribute("SlitherCooldown")

									projectileData.Slithering = true
									local currentVel = hitbox.AssemblyLinearVelocity
									local velRightVector = CFrame.new(Vector3.zero, currentVel).RightVector
									local velUpVector = CFrame.new(Vector3.zero, currentVel).UpVector

									local diff = ((velRightVector * math.random(-intensity*100, intensity*100)/1000) + (velUpVector * math.random(-intensity*100, intensity*100)/1000))
									local targetVel = currentVel + diff

									local time1 = time()
									repeat
										task.wait(.02)
										if not hitbox then break end
										hitbox.AssemblyLinearVelocity += diff * (1 / duration * 25)
										hitbox.AssemblyLinearVelocity -= projectileData.LastSlitherOffset * (2 / duration * 25)
										hitbox.AssemblyLinearVelocity += projectileData.LastSlitherOffset2 * (1 / duration * 25)
									until time() >= time1 + duration/3
									projectileData.LastSlitherOffset2 = projectileData.LastSlitherOffset
									projectileData.LastSlitherOffset = diff

									task.wait(cooldown * math.random(50, 150)/100)
									projectileData.Slithering = false
								end)
							end

							-- Update projectile
							local updateReturn = ProjectileMod.UpdateProjectile({
								Projectile = projectile,
								LastProjectilePosition = projectileData.LastPosition,
								HitAlready = projectileData.HitAlready,
								DeltaTime = delta,
								TimeAtHomingTargetChange = projectileData.TimeAtHomingTargetChanged,
								HomingTarget = projectileData.HomingTarget
							})

							projectileData.HitAlready = updateReturn.HitAlready
							projectileData.LastPosition = updateReturn.LastPosition
							projectileData.HomingTarget = updateReturn.HomingTarget
							projectileData.TimeAtHomingTargetChanged = updateReturn.TimeAtHomingTargetChanged
						end
					end
				end
			end
		end
	end)
end

module = function()
	-- Initialize the centralized Heartbeat connection
	initializeHeartbeat()
	
	-- Listen for new projectiles being created
	Loader.Shared.Modules.Projectiles.ProjectileBindableEvent.Event:Connect(function(projectile)
		-- This is a server-owned projectile, add it to centralized management
		local hitbox = projectile:FindFirstChild("Hitbox")
		
		-- Store projectile data in centralized table
		table.insert(activeProjectiles, {
			Projectile = projectile,
			Hitbox = hitbox,
			LastPosition = hitbox.Position,
			HitAlready = {},
			Slithering = false,
			TimeCreated = time(),
			LastSlitherOffset = Vector3.zero,
			LastSlitherOffset2 = Vector3.zero
		})
	end)
end

return module
]]></ProtectedString>
							<string name="ScriptGuid">{E43BF534-D845-411B-87D3-567C3B258D7D}</string>
