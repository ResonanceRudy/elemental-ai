						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local module = {}
local DSS = game:GetService("DataStoreService")

type DataStoreLoadConfig = {
	DataStore: string,
	Key: string,
	Scope: string?,
}

function module.LoadData(config:DataStoreLoadConfig)
	local success, data = pcall(function()
		return DSS:GetDataStore(config.DataStore, config.Scope):GetAsync(config.Key)
	end)
	if success then
		return data
	else
		warn("Failed to load data: " .. tostring(data))
		return nil
	end
end

type DataStoreSetConfig = {
	DataStore: string,
	Key: string,
	Scope: string?,
	Value: any,
}

--[[
Set just overwrites the old value. It's better for situations where the old value is
irrelevant. It is faster, and more lightweight than Update, but can cause conflicts and
data loss if used at the same time across servers on the same key.
]]

function module.SetData(config:DataStoreSetConfig)
	local success, err = pcall(function()
		DSS:GetDataStore(config.DataStore, config.Scope):SetAsync(config.Key, config.Value)
	end)
	if not success then
		warn("Failed to set data: " .. tostring(err))
		return module.LoadData(config)
	end
end

--[[
Update takes a function that takes the old value as an argument, and returns the new value.
It is slower and more memory-intensive than Set, but it is more reliable and will not lose
data if used at the same time across servers on the same key.
]]
type DataStoreUpdateConfig = {
	DataStore: string,
	Key: string,
	Scope: string?,
	UpdateFunction:	(any) -> any,
}
function module.UpdateData(config:DataStoreUpdateConfig)
	local success, data = pcall(function()
		return DSS:GetDataStore(config.DataStore, config.Scope):UpdateAsync(config.Key, function(oldValue)
			return config.UpdateFunction(oldValue)
		end)
	end)
	if not success then
		warn("Failed to update data: " .. tostring(data))
		return module.LoadData(config)
	end
end

type DataStoreIncrementConfig = {
	DataStore: string,
	Key: string,
	Scope: string?,
	Value: number,
}
function module.IncrementData(config:DataStoreIncrementConfig)
	local success, data = pcall(function()
		return DSS:GetDataStore(config.DataStore, config.Scope):IncrementAsync(config.Key, config.Value)
	end)
	if not success then
		warn("Failed to increment data: " .. tostring(data))
		return module.LoadData(config)
	end
end

return module
]]></ProtectedString>
