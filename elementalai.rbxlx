						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local module = {}


type ChooseRandomOutputConfig = {
	Outputs:{[any]:number},
}
function module.ChooseRandomOutput(config:ChooseRandomOutputConfig)
	local total = 0
	for _, weight in pairs(config.Outputs) do
		total += weight or 1
	end
	local roll = math.random() * total
	
	local cumulative = 0
	for output, weight in pairs(config.Outputs) do
		cumulative += weight or 1
		if roll <= cumulative and weight > 0 then
			return output
		end
	end
end

return module
]]></ProtectedString>
							<string name="ScriptGuid">{0FB069AD-FCD6-4FA1-AEDE-20F026EE315E}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
