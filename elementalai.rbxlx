					<Item class="ModuleScript" referent="RBX2FA50CAAA38A4AC19EFDBADFE65D9052">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local module = {}

function module.HandleStats(char:Model, isCharacter)
	if isCharacter == true or isCharacter == nil  then
		local hum:Humanoid = char:WaitForChild("Humanoid")
		local animator:Animator = hum:WaitForChild("Animator")
	end
	task.wait(.1)

	local DefaultStats = {
		WalkSpeed = 25,
		JumpPower = 50,
		MovementSpeed = 1,
		JumpStrength = 1,
		AttackSpeed = 1,
		Damage = 1,
		Knockback = 1,
		DamageTaken = 1,
		KnockbackTaken = 1,
		--IFramesLevel = 0,
		Scale = 1,
		Gravity = 1,
		GravityDirection = Vector3.new(0, -1, 0),

		Health = 100,
		MaxHealth = 100,
		HealthRegen = 1,
		
		-- Character controller stats
		JumpCooldown = 0.1,
		AirInfluence = 0,
		MaxSlopeAngle = 90,
		GravityPerpendicularToFloor = true,
		StandPerpendicularToFloor = true,
		Friction = 2,
		AccelerationTime = .5,
		DecelerationTime = .5,

		Team = "None",
	}
	for i, v in DefaultStats do
		if not char:GetAttribute(i) then
			char:SetAttribute(i, v)
		end
	end
	local function GetStat(statName)
		return char:GetAttribute(statName)
	end
	local function SetStat(statName, value)
		char:SetAttribute(statName, value)
	end
	local function AddStat(statName, value)
		char:SetAttribute(statName, char:GetAttribute(statName) + value)
	end
	if isCharacter == true or isCharacter == nil then
		task.spawn(function()
			while task.wait(.1) do
				if GetStat("Health") > 0 then
					SetStat("Health", math.clamp(GetStat("Health") + GetStat("HealthRegen") * 0.1, 0, GetStat("MaxHealth")))
				end
			end
		end)

		local function Update(attribute)
			if attribute == "Scale" or attribute == "All" then
				local scale = GetStat("Scale")
				char:ScaleTo(scale)
			end
			if attribute == "MovementSpeed" or attribute == "WalkSpeed" or attribute == "Scale" or attribute == "All" then
				char.Humanoid.WalkSpeed = GetStat("WalkSpeed") * GetStat("MovementSpeed") * GetStat("Scale")
			end
			if attribute == "JumpStrength" or attribute == "JumpPower" or attribute == "Scale" or attribute == "All" then	
				char.Humanoid.UseJumpPower = true
				char.Humanoid.JumpPower = GetStat("JumpPower") * GetStat("JumpStrength") * GetStat("Scale")
			end
			if attribute == "Health" or attribute == "MaxHealth" or attribute == "All" then
				char.Humanoid.MaxHealth = char:GetAttribute("MaxHealth")
				char.Humanoid.Health = char:GetAttribute("Health")
			end
			
			if attribute == "Gravity" or attribute == "GravityDirection" or attribute == "Scale" or attribute == "All" then
				local gravity = workspace.Gravity * GetStat("Gravity") * GetStat("Scale")

				local mass = 0
				for _, part in char:GetChildren() do
					if part:IsA("BasePart") then
						mass += part:GetMass()
					end
				end

				local force:VectorForce = char.HumanoidRootPart:FindFirstChild("GravityForce") or Instance.new("VectorForce")
				force.Force = mass * gravity * GetStat("GravityDirection").Unit + Vector3.new(0, mass * workspace.Gravity, 0)
				force.Attachment0 = char.HumanoidRootPart.RootAttachment
				force.RelativeTo = Enum.ActuatorRelativeTo.World
				force.Name = "GravityForce"
				force.Parent = char.HumanoidRootPart
				force.Enabled = true
			end
		end
		Update("All")
		char.AttributeChanged:Connect(Update)
		if not char:HasTag("Character") then
			char:AddTag("Character")
		end
		
		local eventsFolder = script.Events:Clone()
		eventsFolder.Parent = char
		
		local debuffFolder = script.Debuffs:Clone()
		debuffFolder.Parent = char
	end
end
function module.GetStat(char, statName)
	return char:GetAttribute(char, statName)
end
function module.SetStat(char, statName, value)
	char:SetAttribute(statName, value)
end
function module.AddStat(char, statName, value)
	char:SetAttribute(statName, char:GetAttribute(statName) + value)
end

type ApplyMultipliersConfig = {
	Char:Model,
	OtherChar:Model,
	StatName:string,
	Value:number
}
function module.ApplyMultipliers(config:ApplyMultipliersConfig)
	local charMultiplier = (config.Char and config.Char:GetAttribute(config.StatName)) or 1
	local otherCharMultiplier = (config.OtherChar and config.OtherChar:GetAttribute(config.StatName.."Taken")) or 1
	config.Value *= charMultiplier * otherCharMultiplier
	return config.Value
end


return module]]></ProtectedString>
