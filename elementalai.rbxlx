							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Math</string>
							<int64 name="SourceAssetId">-1</int64>
							<BinaryString name="Tags"></BinaryString>
							<UniqueId name="UniqueId">6d436cc27613dc5b099c05580000390c</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX491ABE3C6FDB47299335DA7D764517CA">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local module = {}

local Loader =  game.ReplicatedStorage:WaitForChild("Loader")
local SharedMods = Loader.Shared.Modules

local RS = game:GetService("RunService")
local Debris = game:GetService("Debris")

type DividePartConfig = {
	XParts: number,
	YParts: number,
	ZParts: number,
	Part: Part
}

function module.DividePart(config:DividePartConfig)
	local xParts = config.XParts
	local yParts = config.YParts
	local zParts = config.ZParts
	
	local part = config.Part
	
	local partSize = part.Size
	local xSize = partSize.X
	local ySize = partSize.Y
	local zSize = partSize.Z
	
	local xSplit = xSize/xParts
	local ySplit = ySize/yParts
	local zSplit = zSize/zParts
	
	local newCFrame = part.CFrame
	local partShape = part.Shape.Name
	
	if partShape == "Block" or partShape == "Cylinder" then
		if partShape == "Cylinder" then
			yParts = 1 
			zParts = 1
			
			ySplit = ySize/yParts
			zSplit = zSize/zParts
		end
		
		-- Calculate the offset to center the grid around the original part's position
		local xOffset = -(xParts * xSplit) / 2 + xSplit / 2
		local yOffset = -(yParts * ySplit) / 2 + ySplit / 2
		local zOffset = -(zParts * zSplit) / 2 + zSplit / 2

		local iterations = 0
		for i = 1,xParts do
			for j = 1,yParts do
				for k = 1,zParts do
					iterations += 1
					if iterations >= 100 then
						RS.Heartbeat:Wait()
						iterations = 0
					end
					
					local newPart = part:Clone()
					
					for i, v in part:GetDescendants() do
						if v:IsA("BasePart") then
							v:Destroy()
						end
					end
					
					newPart.Size = Vector3.new(xSplit,ySplit,zSplit)
					newPart.CFrame = newCFrame * CFrame.new(
						xOffset + (i-1)*xSplit,
						yOffset + (j-1)*ySplit,
						zOffset + (k-1)*zSplit
					)
					newPart.Parent = part.Parent
					newPart.Name = part.Name.."_"..i..j..k
				end
			end
		end
	elseif partShape == "Wedge" then
		if ySplit ~= zSplit then
			local parts = math.min(yParts,zParts)
			yParts = parts
			zParts = parts
			
			ySplit = ySize/parts
			zSplit = zSize/parts
		end
		
		local xOffset = -(xParts * xSplit) / 2 + xSplit / 2
		local yOffset = -(yParts * ySplit) / 2 + ySplit / 2
		local zOffset = -(zParts * zSplit) / 2 + zSplit / 2
		
		local iterations = 0
		local redpart = false
		
		local maxYIterations = 1
		for i = 1,xParts do
			maxYIterations = 1
			for k = 1,zParts do
				for j = 1,yParts do
					iterations += 1
					if iterations >= 100 then
						RS.Heartbeat:Wait()
						iterations = 0
					end
					
					if j > maxYIterations then 
						continue 
					end
					local newPart = part:Clone()
					if j ~= maxYIterations then
						newPart.Shape = Enum.PartType.Block
					end
					newPart.Size = Vector3.new(xSplit,ySplit,zSplit)
					newPart.CFrame = newCFrame * CFrame.new(
						xOffset + (i-1)*xSplit,
						yOffset + (j-1)*ySplit,
						zOffset + (k-1)*zSplit
					)
					newPart.Parent = part.Parent
					newPart.Name = part.Name.."_"..i..j..k
				end
				maxYIterations += 1
			end
		end
	elseif partShape == "CornerWedge" then
		local parts = math.ceil((xParts + yParts + zParts + math.min(xParts,yParts,zParts)*2)/5)
		if xSplit ~= zSplit or xSplit ~= ySplit then
			xParts = parts
			zParts = parts
			yParts = parts

			xSplit = xSize/parts
			zSplit = zSize/parts
			ySplit = ySize/parts
		end

		local xOffset = (xParts * xSplit) / 2 + xSplit / 2
		local yOffset = -(yParts * ySplit) / 2 + ySplit / 2
		local zOffset = -(zParts * zSplit) / 2 + zSplit / 2

		local iterations = 0

		local maxXZIterations = parts
		for j = 1,yParts do
			for k = 1,zParts do
				for i = 1,xParts do
					iterations += 1
					if iterations >= 100 then
						RS.Heartbeat:Wait()
						iterations = 0
					end

					if k > maxXZIterations or i > maxXZIterations then 
						continue 
					end
					local cfAngleAddition = CFrame.Angles(0,0,0)
					local newPart = part:Clone()
					local partSize = Vector3.new(xSplit,ySplit,zSplit) 
					
					if k == maxXZIterations and i == maxXZIterations then
						newPart.Shape = Enum.PartType.CornerWedge
					elseif k == maxXZIterations or i == maxXZIterations then
						newPart.Shape = Enum.PartType.Wedge
						if i > k then
							cfAngleAddition = CFrame.Angles(0,math.rad(90),0)
							partSize = Vector3.new(zSplit,ySplit,xSplit)
						else
							cfAngleAddition = CFrame.Angles(0,math.rad(180),0)
						end
					else
						newPart.Shape = Enum.PartType.Block
					end
					
					newPart.Size = partSize
					newPart.CFrame = newCFrame * CFrame.new(
						xOffset - (i)*xSplit,
						yOffset + (j-1)*ySplit,
						zOffset + (k-1)*zSplit
					) * cfAngleAddition
					newPart.Parent = part.Parent
					newPart.Name = part.Name.."_"..i..j..k
				end
			end
			maxXZIterations -= 1
		end
	end
	part:Destroy()
end

type MakeModelDestructibleConfig = {
	Model: Model
}

-- WARNING: MAKE SURE ALL PARTS ARE ANCHORED BEFORE CALLING THIS FUNCTION
-- OR ELSE PARTS MIGHT SHIFT WHILE DIVIDING
function module.MakeModelDestructible(config:MakeModelDestructibleConfig)
	local model = config.Model
	-- Divide parts
	for i, v in model:GetDescendants() do
		if v:IsA("Part") and v.Shape.Name ~= "Ball" and not v:HasTag("Indestructible") then
			local Size = v.Size
			local Shape = v.Shape.Name
			local totalSize = Size.X + Size.Y + Size.Z
			local xComponent = Size.X/totalSize
			local yComponent = Size.Y/totalSize
			local zComponent = Size.Z/totalSize
			
			local xBlocks =  math.ceil(Size.X/3 - Size.X/6) 
			local yBlocks =  math.ceil(Size.Y/3 - Size.Y/6)
			local zBlocks =  math.ceil(Size.Z/3 - Size.Z/6)
			
			local blockCount = xBlocks * yBlocks * zBlocks
			
			if Shape == "Cylinder" then
				blockCount = xBlocks
			elseif Shape == "Wedge" then
				blockCount *= .5
			elseif Shape == "CornerWedge" then
				blockCount /= 3
			end
			
			
			 
			if blockCount >= 25 then
				if v:HasTag("Destructible") == false and blockCount >= 50 then
					v:AddTag("Indestructible") 
				else
					v.Anchored = true
					module.DividePart({
						Part = v,
						XParts = xBlocks,
						YParts = yBlocks,
						ZParts = zBlocks
					})
				end
			else
				v.Anchored =  true
				module.DividePart({
					Part = v,
					XParts = xBlocks,
					YParts = yBlocks,
					ZParts = zBlocks
				})
			end
		end
	end

	-- Setting Collision Groups
	for i, v in model:GetDescendants() do
		if v:IsA("BasePart") then
			v.CollisionGroup = "Map"
		end
	end

	-- Make parts destructible
	local iterations = 0
	for i, v in model:GetDescendants() do
		--RS.Heartbeat:Wait()
		iterations += 1
		if iterations >= 100 then
			RS.Heartbeat:Wait()
			iterations = 0
		end
		if v:IsA("BasePart") and v:HasTag("Indestructible") == false then
			local nearbyParts = workspace:GetPartBoundsInBox(v.CFrame, v.Size * 1.1)
			for i1, v1 in pairs(nearbyParts) do
				if v1:IsDescendantOf(model) then
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = v
					weld.Part1 = v1
					weld.Parent = v
				end
			end
			v.Anchored = false
			v:SetAttribute("MaxHealth", 20 + (v.Size.Magnitude * 4))
			v:SetAttribute("Health", v:GetAttribute("MaxHealth"))
			v:SetAttribute("DebrisVelocity", Vector3.new(0,0,0))
			v:SetAttribute("Destroyed", false)
			v.AttributeChanged:Connect(function(attribute)
				if attribute == "Health" and not v:GetAttribute("Destroyed") then
					local maxHealth = v:GetAttribute("MaxHealth")
					local health = v:GetAttribute("Health")
					if health <= 0 then
						v:SetAttribute("Destroyed", true)
						
						local joints = v:GetJoints()
						local shift = 0
						for i1, v1 in table.clone(joints)  do
							joints[i1 - shift]:Destroy()
							table.remove(joints, i1 - shift)
							shift += 1
						end
						script.PartDestructionEvent:FireAllClients(v)
						if RS:IsRunMode() then
							local part = v:Clone()
							part.AssemblyLinearVelocity = v:GetAttribute("DebrisVelocity")
							part.AssemblyAngularVelocity += Vector3.new(math.random(-25, 25), math.random(-25, 25), math.random(-25, 25))
							part.CollisionGroup = "Debris"

							local debrisFolder = workspace:FindFirstChild("Debris") or Instance.new("Folder")
							debrisFolder.Name = "Debris"
							debrisFolder.Parent = workspace
							part.Parent = debrisFolder
							Debris:AddItem(part, 11)

							task.wait(math.random(50, 100)/10)
							for count = 1, 50, 1  do
								part.Transparency += .02
								task.wait()
							end
							part:Destroy()
						end
						
						v.CanQuery = false
						v.CanTouch = false
						v.CanCollide = false
						v.Anchored = true
						v.Transparency += 1
						
						for i, emitter in v:GetChildren() do
							if emitter:IsA("ParticleEmitter") then
								if emitter.Enabled then
									emitter.Enabled = false
								else 
									emitter:Destroy()
								end
							end
						end
					else
						v:SetAttribute("DebrisVelocity", Vector3.zero)
					end
				end
			end)
		end
	end
end

return module
]]></ProtectedString>
							<string name="ScriptGuid">{F2CEF870-CD4B-44B3-9F1F-02E54BD1E545}</string>
