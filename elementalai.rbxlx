							<ProtectedString name="Source"><![CDATA[local module = {}
local BadgeService = game:GetService("BadgeService")

type BadgeConfig = {
	Player: Player,
	BadgeId: number,
}

function module.AwardBadge(config:BadgeConfig)
	local success, result = pcall(function()
		return BadgeService:AwardBadgeAsync(config.Player.UserId, config.BadgeId)
	end)
	if not success then
		warn("Failed to award badge: " .. tostring(result))
	end
end

function module.CheckBadge(config:BadgeConfig)
	local success, result = pcall(function()
		return BadgeService:UserHasBadgeAsync(config.Player.UserId, config.BadgeId)
	end)
	if not success then
		warn("Failed to check badge: " .. tostring(result))
	end
	return result
end

return module
