				<Item class="Script" referent="RBX8B6D748F50954E11890E21549754C54A">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local serverCombatMod = require(game.ServerStorage:WaitForChild("ServerSide").Modules.ServerCombat)
local char = (script.Parent.Name == "Debuffs" and script.Parent.Parent) or script.Parent

local fireEffects = {}

function AddEffect(part, effectName)
	local fireEffect = script[effectName]:Clone()
	fireEffect.Parent = part
	fireEffect.Enabled = true
	table.insert(fireEffects, fireEffect)
end

if char:IsA("BasePart") and not char:GetAttribute("Destroyed") then
	AddEffect(char, "FireDamageEffectMap")
else
	for i, v in char:GetChildren() do
		if v:IsA("BasePart") then
			AddEffect(v, "FireDamageEffect")
		end
	end
end

local timeStarted = time()
while time() - timeStarted < script:GetAttribute("Duration") do
	task.wait(.1)
	
	if char:IsA("BasePart") then
		char.Color = Color3.new(char.Color.R * .995, char.Color.G * .995, char.Color.B * .995)
	end
	
	serverCombatMod.DealDamage({
		Attacker = script.Owner.Value,
		Target = char,
		Damage = script:GetAttribute("DPS")/10,
		TriggerEvents = false
	})
end

for i, v in fireEffects do
	v.Enabled = false
	task.delay(v.Lifetime.Max, function()
		v:Destroy()
	end)
end
task.wait(1)
script:Destroy()]]></ProtectedString>
