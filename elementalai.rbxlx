						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local module = {}

function module.Reflect(direction, normal)
	return direction - 2 * direction:Dot(normal) * normal
end

function module.GetAngle(v1, v2)
	return math.round(math.deg(math.acos(v1.Unit:Dot(v2.Unit)))*10)/10
end
function module.GetRightVector(vect)
	local cf = CFrame.new(Vector3.zero, vect)
	return cf.RightVector
end
type OffsetConfig = {
	Range:number,
	InitialLook:Vector3,
	
	XMaxAngle:number,
	YMaxAngle:number,
	ZMaxAngle:number,
}
function module.RandomOffsetInRange(config:OffsetConfig)
	if not config.XMaxAngle then
		config.XMaxAngle = 360
	end
	if not config.YMaxAngle then
		config.YMaxAngle = 360
	end
	if not config.ZMaxAngle then
		config.ZMaxAngle = 360
	end
	
 	local look = (CFrame.lookAlong(Vector3.zero, config.InitialLook) * CFrame.Angles(math.rad(math.random(-config.XMaxAngle, config.XMaxAngle)/2), math.rad(math.random(-config.YMaxAngle, config.YMaxAngle)/2), math.rad(math.random(-config.ZMaxAngle, config.ZMaxAngle)/2))).LookVector
	
	return (look * config.Range * math.random(1, config.Range * 1000) / 1000)
end

type SpreadConfig = {
	Spread:number,
	LookVector:Vector3,
}
function module.AddSpread(config:SpreadConfig)
	local spread = config.Spread
	local look = config.LookVector
	
	local cf = CFrame.new(Vector3.zero, look) * CFrame.Angles(math.rad(math.random(-spread*100, spread*100)/50), math.rad(math.random(-spread*100, spread*100)/50), 0)
	return cf.LookVector
end


return module]]></ProtectedString>
