					</Item>
					<Item class="ModuleScript" referent="RBXD4A2C3B0A5B64FC79E313AC6630B0D9E">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local module = {}

-- GetPartsInPart
export type GetPartsInPartConfig = {
	Part:BasePart,
	FilterType:Enum.RaycastFilterType,
	FilterDescendantsInstances:{Instance}?,
	CollisionGroup:string,
	MaxParts:number
}
function module.GetPartsInPart(config:GetPartsInPartConfig)
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = config.FilterType or Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = config.FilterDescendantsInstances or {}
	overlapParams.CollisionGroup = config.CollisionGroup or "Hitbox"
	overlapParams.MaxParts = config.MaxParts or math.huge
	
	return workspace:GetPartsInPart(config.Part, overlapParams)
end

-- GetPartBoundsInBox
export type GetPartBoundsInBoxConfig = {
	CFrame:CFrame,
	Size:Vector3,
	FilterType:Enum.RaycastFilterType,
	FilterDescendantsInstances:{Instance},
	CollisionGroup:string,
	MaxParts:number
}

function module.GetPartBoundsInBox(config:GetPartBoundsInBoxConfig)
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = config.FilterType or Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = config.FilterDescendantsInstances or {}
	overlapParams.CollisionGroup = config.CollisionGroup or "Hitbox"
	overlapParams.MaxParts = config.MaxParts or math.huge
	
	return workspace:GetPartBoundsInBox(config.CFrame, config.Size, overlapParams)
end

-- GetPartBoundsInRadius
export type GetPartBoundsInRadiusConfig = {
	Position:Vector3,
	Radius:number,
	FilterType:Enum.RaycastFilterType,
	FilterDescendantsInstances:{Instance},
	CollisionGroup:string,
	MaxParts:number
}

function module.GetPartBoundsInRadius(config:GetPartBoundsInRadiusConfig)
	
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = config.FilterType or Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = config.FilterDescendantsInstances or {}
	overlapParams.CollisionGroup = config.CollisionGroup or "Hitbox"
	overlapParams.MaxParts = config.MaxParts or math.huge

	return workspace:GetPartBoundsInRadius(config.Position, config.Radius, overlapParams)
end

-- Raycast
export type RaycastConfig = {
	Origin:Vector3,
	Direction:Vector3,
	MaxDistance:number?,
	FilterType:Enum.RaycastFilterType,
	FilterDescendantsInstances:{Instance},
	CollisionGroup:string,
	
	RaycastType:string,
	
	Size:Vector3?,
	Radius:number,
	Part:BasePart
}

function module.Raycast(config:RaycastConfig)
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = config.FilterType or Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = config.FilterDescendantsInstances or {}
	raycastParams.CollisionGroup = config.CollisionGroup or "Hitbox"
	
	if config.RaycastType == "Raycast" or not config.RaycastType then
		return workspace:Raycast(config.Origin, config.Direction.Unit * (config.MaxDistance or 10000), raycastParams)
	elseif config.RaycastType == "Blockcast" then
		return workspace:Blockcast(CFrame.lookAlong(config.Origin, config.Direction.Unit), config.Size, config.Direction.Unit * (config.MaxDistance or 10000), raycastParams)
	elseif config.RaycastType == "Spherecast" then
		return workspace:Spherecast(config.Origin, config.Radius, config.Direction.Unit * (config.MaxDistance or 10000), raycastParams)
	elseif config.RaycastType == "Shapecast" then
		if not config.Part then
			local part = script.Parent.Parent.Assets.GhostPart:Clone()
			part.Size = config.Size
			part.CFrame = CFrame.lookAlong(config.Origin, config.Direction.Unit)
			part.Parent = workspace
			config.Part = part
		end
		return workspace:Shapecast(config.Part, config.Direction.Unit * (config.MaxDistance or 10000), raycastParams)
	end
end




return module
]]></ProtectedString>
							<string name="ScriptGuid">{3555C7A6-5EBC-45FA-B23E-159F3594566B}</string>
